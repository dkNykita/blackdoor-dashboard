# utils/grab - Shared Recursive File Download
# Usage: import "utils/grab" as ug
# Takes a utils/net module instance (nu) as a parameter instead of
# importing it itself - see utils/net.bd for why.

# Per-file callback for nu.walk_tree() - context unused (none).
#
# download() logs its own "Downloaded: <path> (<size>)" line on success
# (confirmed live) - no success log() needed here, that would just
# duplicate it (confirmed live too, as a second plain-white line under
# download()'s own colored one).
#
# download() can fail per-file for reasons unrelated to walk_tree() itself
# (permission denied even on an account-owned, world-readable file per
# `ls` - confirmed live; also documented but never seen live: race_locked)
# - used to be silently dropped (do_grab() just under-counted with no
# indication why). Failure is always surfaced now, so a "Done. Downloaded
# 0 files." never happens without an explanation right above it.
func grab_on_file(conn, path, f, context):
    var result = download(conn, path)
    if not result.success:
        log("Skipped " + path + ": " + (result.error != "" ? result.error : "download failed") + ".", Color.amber)
    return {"conn": conn, "reconnected": false, "value": result.success ? 1 : 0}

func do_grab(nu, host, account, path):
    var connect_str = account + "@" + host
    var conn = nu.connect_or_raise(connect_str)
    var r = nu.walk_tree(conn, connect_str, host, path, grab_on_file, none)
    var count = 0
    for v in r.results:
        count = count + v
    disconnect(r.conn)
    var total = len(r.results)
    var failed = total - count
    if failed > 0:
        log("Done. Downloaded " + str(count) + "/" + str(total) + " files (" + str(failed) + " failed - see above).", Color.amber)
    else:
        log("Done. Downloaded " + str(count) + " files.")
    return count
