# utils/probe - Shared Port Scanning
# Usage: import "utils/probe" as up
# Takes a utils/net module instance (nu) as a parameter instead of
# importing it itself - see utils/net.bd for why.

# Returns [{port, service}, ...] for whichever of the given ports are
# open. Logs progress every 1000 ports scanned (meaningful for a full
# 65535-port sweep; a no-op for the much shorter common-port list).
func scan_ports(nu, target, ports):
    var found = []
    var scanned = 0
    for port in ports:
        nu.throttle(nu.cpu_guard_fast())
        var result = scan(target, port)
        if result.open:
            found.append({"port": port, "service": result.service})
            log("Port " + str(port) + " open: " + result.service, Color.green)
        scanned = scanned + 1
        if scanned % 1000 == 0:
            log("Scanning... " + str(scanned) + "/" + str(len(ports)))
    return found

func common_ports():
    return [20, 21, 22, 23, 25, 53, 69, 80, 110, 111, 135, 139, 143, 161, 162, 389, 443, 445, 465, 514, 587, 636, 993, 995, 1433, 1521, 2049, 3306, 3389, 5432, 5900, 6379, 8000, 8080, 8443, 8888, 9200, 11211, 27017, 31337]

func do_probe(nu, target):
    var ports = common_ports()
    log("Scanning " + target + " (" + str(len(ports)) + " common ports)...")
    var found = scan_ports(nu, target, ports)
    log("Scan complete. Found " + str(len(found)) + " open ports.")
    return found

func do_probe_full(nu, target):
    log("Scanning " + target + " (65535 ports)...")
    var found = scan_ports(nu, target, range(1, 65536))
    log("Scan complete. Found " + str(len(found)) + " open ports.")
    return found
