# tests/T02.bd - T02: THE TICK RULER.
#
# ONE QUESTION: does the engine actually BLOCK a script once the current
# second's tick budget is spent - i.e. is elapsed wall-clock time a linear
# readout of executed-statement count - and if so, how many real SECONDS
# does one executed statement cost (hence: what CPU tier is this machine)?
#
# WHY IT MATTERS: every timing number this investigation owns (the ~3.7s
# throttle cost, the +122.5s baseline, the 98.6020s reproducibility, the
# five crash points at +40.7/+111.0/+40.3/+65.5/+64.3s) is read as if
# elapsed time == work done. That is only true if the engine blocks on
# tick exhaustion. Nobody has ever checked. Separately, the player's
# actual tick rate appears NOWHERE in the corpus - every calculation in
# field_notes.txt silently assumes base tier (10 ticks/sec). This script
# measures both, and touches get_cpu() ZERO times.
#
# THE UNIT: exactly one source line of the form  a = a + 1.  Every other
# timing test in this programme is written in that same unit, so their
# spans convert straight into ticks via the constant this script produces.
#
# DESIGN: five phases, IDENTICAL in every respect except how many unit
# lines sit inside the timed window (0 / 10 / 20 / 30 / 0 again). The
# timed window is bracketed by two get_unix_time() reads and contains
# NOTHING else - no sleep, no log, no get_cpu, no string building. All
# sleeps and all logging happen OUTSIDE the window, so instrumentation
# cost can never enter the measurement. Because the bracketing lines are
# identical in all five phases, they cancel exactly in the differences.
#
# HOW TO READ THE RESULT:
#   block= is the whole measurement: seconds spent executing K unit lines.
#
#   CONFIRMED (engine blocks; wall clock IS a work meter):
#     block rises monotonically 0 -> 10 -> 20 -> 30 with EQUAL steps.
#     sec_per_unit = (mean block at 30 - mean block at 0) / 30
#     tick_rate    = 1 / sec_per_unit
#       ~0.100 s/unit -> 10 ticks/sec  (base tier)
#       ~0.050 s/unit -> 20 ticks/sec  (Mk.II)
#       ~0.025 s/unit -> 40 ticks/sec  (Mk.III)
#       ~0.0125 s/unit -> 80 ticks/sec (Mk.IV)
#     Base-tier prediction: P0 ~0.1s, P10 ~1.1s, P20 ~2.1s, P30 ~3.1s.
#
#   REFUTED (engine does NOT block on tick exhaustion):
#     block= is ~0.00-0.05s at EVERY arm including 30, and the five
#     PHASE span= totals are all equal within ~1s. Then wall-clock time
#     is not a work meter, every elapsed-time conclusion in field_notes
#     measures something else, and every timing-based test downstream of
#     this one must be re-cut to kill / no-kill observables instead.
#
#   NOT LINEAR: the three steps disagree by more than ~2x from each
#     other (e.g. 1.0s then 3.0s) -> per-statement cost is not constant
#     and no single ruler exists; report the curve, do not fit a slope.
#
#   RULER TOO COARSE: the four block= values inside ONE phase spread by
#     more than 0.5s -> this instrument has no usable precision and
#     every single-run A/B in the corpus is uninterpretable.
#
#   INTEGER CLOCK: if every block= prints as a whole number with no
#     decimals (0, 1, 2, 3), get_unix_time() has 1-SECOND resolution
#     (the official reference does declare it "-> int", even though past
#     traces show values like +98.6020s). In that case IGNORE block= and
#     read the PHASE span= totals instead: they aggregate 4 rounds, so
#     each arm step is 4 x 10 x sec_per_unit (= 4.0s per step at base
#     tier) and survives 1-second quantization.
#
#   DRIFT CONTROL: PHASE-0B repeats PHASE-0 at the END. If its block=
#     values match PHASE-0's, there was no session warm-up masquerading
#     as a slope. If they differ materially, the ascending arm order is
#     confounded - re-run with the phases in descending order.
#
#   INTEGRITY: a= must read exactly 0,0,0,0 / 10,20,30,40 / 60,80,100,
#     120 / 150,180,210,240 / 240,240. Any other value means the burst
#     did not execute the statement count the source shows, which
#     invalidates that phase's block=.
#
# SAFETY / IS THE BURST THE EXPERIMENT? Partly yes - the 30-unit window
# IS a deliberate unpaced burst, because measuring an unpaced burst is
# the point. It is sized to stay inside the kill window: 30 lines is
# ~3.0s of continuous load at base tier, under the documented ~5s-at-100%
# kill, and far under test_cpu_decay.bd's known-lethal ~100-150-tick
# loop. Every burst is bracketed by sleep(2) on both sides (4s idle per
# ~3s of burn). Phases run SMALLEST FIRST on purpose: if PHASE-30 kills
# the script, PHASE-0/10/20 have already printed and still give a slope,
# and the kill itself is a separate datum (an unpaced 30-line straight
# burst is lethal on this tier).
#
# HOW TO RUN:
#   1) Fresh game start if convenient. Run `ps` and `jobs`, confirm
#      nothing else is running, and paste that output too.
#   2) Save as ~/scripts/T02.bd and run `T02`.
#   3) Paste back EVERY line it printed, verbatim, including the RULER
#      header lines and the PHASE begin/end lines.
#   4) Run it TWICE, back to back in the same session. A third run only
#      if the two disagree on sec_per_unit by more than 15%.
#   5) If it dies, paste what printed anyway - a paste that ends at a
#      "PHASE-NN begin" line localizes the kill to that exact burst size.
# ~115 seconds per run at base tier; less on a faster tier, which is
# itself part of the answer.

var t0 = get_unix_time()
var a = 0
var r = 0
var ts = 0
var te = 0
var m0 = 0
var span = 0

log("RULER-CLOCK raw=" + str(t0) + " (decimals => float clock; whole number => 1s resolution, read span= not block=)")
log("RULER-START arms=0,10,20,30,0B rounds=4,4,4,4,2 unit='a = a + 1' get_cpu_calls=0")
sleep(2)

log("PHASE-0 begin at=" + str(get_unix_time() - t0))
m0 = get_unix_time()
r = 0
while r < 4:
    sleep(2)
    ts = get_unix_time()
    te = get_unix_time()
    sleep(2)
    log("P0 r=" + str(r) + " units=0 block=" + str(te - ts) + " a=" + str(a) + " at=" + str(te - t0))
    r = r + 1
span = get_unix_time() - m0
log("PHASE-0 end span=" + str(span) + " units=0 rounds=" + str(r) + " a=" + str(a))

log("PHASE-10 begin at=" + str(get_unix_time() - t0))
m0 = get_unix_time()
r = 0
while r < 4:
    sleep(2)
    ts = get_unix_time()
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    te = get_unix_time()
    sleep(2)
    log("P10 r=" + str(r) + " units=10 block=" + str(te - ts) + " a=" + str(a) + " at=" + str(te - t0))
    r = r + 1
span = get_unix_time() - m0
log("PHASE-10 end span=" + str(span) + " units=10 rounds=" + str(r) + " a=" + str(a))

log("PHASE-20 begin at=" + str(get_unix_time() - t0))
m0 = get_unix_time()
r = 0
while r < 4:
    sleep(2)
    ts = get_unix_time()
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    te = get_unix_time()
    sleep(2)
    log("P20 r=" + str(r) + " units=20 block=" + str(te - ts) + " a=" + str(a) + " at=" + str(te - t0))
    r = r + 1
span = get_unix_time() - m0
log("PHASE-20 end span=" + str(span) + " units=20 rounds=" + str(r) + " a=" + str(a))

log("PHASE-30 begin at=" + str(get_unix_time() - t0))
m0 = get_unix_time()
r = 0
while r < 4:
    sleep(2)
    ts = get_unix_time()
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    te = get_unix_time()
    sleep(2)
    log("P30 r=" + str(r) + " units=30 block=" + str(te - ts) + " a=" + str(a) + " at=" + str(te - t0))
    r = r + 1
span = get_unix_time() - m0
log("PHASE-30 end span=" + str(span) + " units=30 rounds=" + str(r) + " a=" + str(a))

log("PHASE-0B begin at=" + str(get_unix_time() - t0) + " (drift control - must match PHASE-0)")
m0 = get_unix_time()
r = 0
while r < 2:
    sleep(2)
    ts = get_unix_time()
    te = get_unix_time()
    sleep(2)
    log("P0B r=" + str(r) + " units=0 block=" + str(te - ts) + " a=" + str(a) + " at=" + str(te - t0))
    r = r + 1
span = get_unix_time() - m0
log("PHASE-0B end span=" + str(span) + " units=0 rounds=" + str(r) + " a=" + str(a))

log("RULER-DONE total=" + str(get_unix_time() - t0) + " a=" + str(a) + " (a must be 240)")
