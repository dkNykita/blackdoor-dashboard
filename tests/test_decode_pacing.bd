# tests/test_decode_pacing.bd - A/B test: does decode_tuple_list()'s
# current single per-item throttle() (utils/hostdata.bd) survive being
# hammered repeatedly, or does it eventually CPU-overload the same way
# menu.bd's real get_entry()/read_entries() run did? And if PART A does
# crash, does adding ONE extra throttle() mid-item (PART B, a local copy
# with the fix) measurably delay or prevent it?
#
# Why this shape: field_notes.txt's test_cpu_decay.bd burst result proved
# 50 totally unpaced plain lines alone crash the script - no function
# calls needed. decode_tuple_list()'s per-item body (kv=split, dict-build,
# a field-by-field while loop, append) runs ~9-13 unpaced lines between
# one throttle() call and the next for a 2-3 field item - not 50, but
# squarely in the same danger family, especially once repeated across many
# items/tokens/lines the way a real host_intel.txt run does. Real trace
# also showed every throttle() costing a near-constant ~3.7s (~3-4 sleep(1)
# retries) regardless of what preceded it - consistent with "each item's
# unpaced stretch spikes get_cpu() by roughly the same amount every time,
# takes ~3-4s to decay back under threshold" rather than anything exotic.
#
# HOW TO RUN: change PART below to "A" or "B", run, note whether/when it
# CPU-overloads (and after how many rounds), then switch and re-run as a
# SEPARATE script execution (comparing within one run would let whichever
# runs second inherit the first's leftover load and contaminate the
# comparison). Kept under tests/ per the updated convention - not deleted
# after use, re-run whenever this needs re-checking.

import "/home/Nykita/scripts/utils/net" as nu
sleep(1)
import "/home/Nykita/scripts/utils/hostdata" as uhd
sleep(1)

var PART = "A"   # "A" = real unmodified decode_tuple_list(), "B" = +1 mid-item throttle

# Same shape as the real crash trace's worst-case tokens (3-item ports,
# 3-item users) - the two tokens that took 14.3s to decode each in the
# original menu.bd run.
var users_blob = "root:1,anon42:1,www-data:1"
var ports_blob = "21:ftp,22:ssh,80:http"

# Local copy of decode_tuple_list() with ONE extra throttle() added after
# building each item, before append - halves the longest unpaced stretch
# per item from ~9-13 lines down to ~5-7. Kept as a plain top-level func
# (this is a script, not a module, so a call-bearing func def is fine).
func decode_tuple_list_v2(nu, blob, field_names, field_types):
    if blob == "":
        return []
    var items = []
    for chunk in blob.split(","):
        nu.throttle(nu.cpu_guard_fast())
        var kv = chunk.split(":")
        var item = {}
        var j = 0
        while j < len(field_names):
            var raw = kv[j]
            if field_types[j] == "int":
                item[field_names[j]] = int(raw)
            elif field_types[j] == "bool":
                item[field_names[j]] = raw == "1"
            else:
                item[field_names[j]] = raw
            j = j + 1
        nu.throttle(nu.cpu_guard_fast())
        items.append(item)
    return items

var t0 = get_unix_time()
log("=== PART " + PART + " - starting, cpu=" + str(get_cpu()) + " ===")

var round = 0
while round < 40:
    log("round " + str(round) + "  t=+" + str(get_unix_time() - t0) + "s  cpu=" + str(get_cpu()))
    if PART == "A":
        var users = uhd.decode_tuple_list(nu, users_blob, ["name", "cracked"], ["str", "bool"])
        var ports = uhd.decode_tuple_list(nu, ports_blob, ["port", "service"], ["int", "str"])
    else:
        var users2 = decode_tuple_list_v2(nu, users_blob, ["name", "cracked"], ["str", "bool"])
        var ports2 = decode_tuple_list_v2(nu, ports_blob, ["port", "service"], ["int", "str"])
    round = round + 1

log("=== PART " + PART + " survived all 40 rounds, t=+" + str(get_unix_time() - t0) + "s ===")
