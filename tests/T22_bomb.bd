# ============================================================================
# tests/T22_bomb.bd  -  T22, file 1 of 2.  THE EXECUTIONER.
# Run this one BACKGROUNDED (`run T22_bomb &`), then start
# T22 in the FOREGROUND while this one's fuse is still burning.
# ============================================================================
#
# ONE QUESTION (T22): when one process CPU-overloads, is the kill
# SESSION-WIDE (it takes down a second, perfectly-paced process) or
# PER-PROCESS (only the offender dies)? And on the session-wide branch, what
# did the victim's own get_cpu() read in the seconds while the killer fired?
#
# WHY IT HAS NEVER BEEN ANSWERED: security_guide.txt says verbatim "Stay at
# 100% CPU for 5 straight seconds and every running script gets killed", and
# the in-game banner says "All processes terminated" - but every single test
# in this investigation has run exactly ONE process, so the word "every" has
# never once been observed. get_cpu() is documented as an aggregate "across
# all your running processes" and that aggregation has never been probed
# either.
#
# THE UNPACED BURN IS THE EXPERIMENT. The while loop below has NO sleep() on
# purpose - it is supposed to die. A kill here is the RESULT, not a failure.
# Every other line in this file is paced (never more than 5 executed lines
# between sleeps) so that nothing except the burn can be blamed for the
# overload.
#
# WHY THE BURN IS BOUNDED BY TIME, NOT BY AN ITERATION COUNT:
#   `while get_unix_time() - tb < BURN` runs flat out, zero sleeps, for
#   exactly BURN wall-clock seconds regardless of CPU tier. A fixed iteration
#   count is either too small to sustain 100% for the documented 5 seconds on
#   a fast tier, or - at the 5000 iterations an earlier draft proposed, about
#   1500s of tick budget at base tier - a 25-minute hang if no kill ever
#   comes. This shape is lethal at every tier AND has a hard 20-second worst
#   case. The price paid for that: this bomb reports elapsed TIME, not a work
#   count, so it cannot measure whether a second live process shortens its
#   own fuse. That budget-sharing question belongs to T21, not here.
#
# WHY IT WRITES A FILE: a backgrounded script's log() goes to the background
# process log, not the terminal (web_api.txt, log()), so this script's own
# log lines are NOT readable at the moment they matter. save() is documented
# 0 ticks and the file outlives the process however it ends, so
# `cat /home/Nykita/t22_bomb.txt` is an instrument the measured event cannot
# destroy. The FILE is the authoritative record of what this process did; the
# terminal banner is corroboration only (whether the banner even appears for
# a backgrounded offender is itself untested).
#
# READING /home/Nykita/t22_bomb.txt AFTERWARDS
#   state=ARMED     -> died during the fuse, before ever burning. ANOMALY -
#                      nothing here should be able to kill it. Report it.
#   state=BURNING   -> the burn started and this process never came back.
#                      THE BOMB WAS KILLED. This is the expected reading.
#   state=SURVIVED  -> it ran a full 20 seconds of completely unpaced
#                      execution and lived. That refutes the unpaced-burst
#                      lethality model at this tier and is a BIGGER finding
#                      than anything this test was built to measure. Report
#                      it immediately and stop.
#   burn_start=<u>  -> absolute unix time the burn began. THIS IS THE PIVOT.
#                      Every victim log line carries u=<absolute time>, so
#                      victim_last_u - burn_start = the kill latency, and any
#                      victim poll with u >= burn_start happened WHILE the
#                      killer was firing.
#
# HOW TO RUN (full protocol lives in T22.bd's header):
#     ps                              (confirm nothing is running)
#     run T22_bomb &
#     run T22             (IMMEDIATELY - within ~5s)
#     ...watch the terminal, touch nothing...
#     ps                              (is anything still listed?)
#     cat /home/Nykita/t22_bomb.txt
#     cat /home/Nykita/t22_victim.txt        (then again 10s later)
# REPEATS: 3 runs of ARM 1, stopping at 2 if both agree on both readouts.
#
# PATHS: /home/Nykita/ is assumed to be home. If this save() errors, change
# the F constant here AND in T22.bd to a directory that exists.
# @param fuse "seconds to wait before burning - time to launch the victim" default=15

var FUSE = int(get_param("fuse", "15"))
var BURN = 20
var F = "/home/Nykita/t22_bomb.txt"
save(F, "state=ARMED fuse=" + str(FUSE) + " burn=" + str(BURN))
log("T22 BOMB ARMED - run T22 NOW. Burn starts in " + str(FUSE) + "s.")
sleep(FUSE)
var tb = get_unix_time()
save(F, "state=BURNING burn_start=" + str(tb) + " burn=" + str(BURN))
log("T22 BOMB BURNING u=" + str(tb))
var n = 0
while get_unix_time() - tb < BURN:
    n = n + 1
save(F, "state=SURVIVED burn_start=" + str(tb) + " burn_end=" + str(get_unix_time()) + " iters=" + str(n))
log("T22 BOMB SURVIVED the full " + str(BURN) + "s unpaced burn, iters=" + str(n) + " - NO KILL HAPPENED")
