# T04 - METER RESPONSE FUNCTION (revised after adversarial review)
# Full rationale, predictions and decision table: tests/README.txt, T04 entry.
#
# THIS HEADER IS DELIBERATELY SHORT. The corpus establishes that load cost
# scales with a file's TOTAL line count including lines that never execute
# (import cost is proportional to the whole file, function bodies included).
# The previous 388-line version of this test could therefore have arrived at
# PART A with the meter already pre-charged by its own 218-line comment block.
# Line 2 now MEASURES that. Keep this file short.
#
# PASTE EVERY LINE BEGINNING "T04", IN ORDER, AT FULL FLOAT PRECISION.
# Do not round, do not tidy. The trailing digits are the signal.
# Run `ps` and `jobs` first, confirm both empty, paste that too.

var cboot = 0
cboot = get_cpu()
var t0 = get_unix_time()
var f = 0
var c1 = 0
sleep(1)
var c2 = 0
var c3 = 0
var c4 = 0
var c5 = 0
sleep(1)
var a1 = 0
var a2 = 0
var a3 = 0
var a4 = 0
sleep(1)
var a5 = 0
var d1 = 0
var d2 = 0
var d3 = 0
sleep(1)
var c = 0
log("T04 boot cpu=" + str(cboot))
sleep(10)

# ============================================================
# PART A - five back-to-back reads, no other lines between them.
# Step = cost of ONE get_cpu() line, in meter points.
# ============================================================
c1 = get_cpu()
c2 = get_cpu()
c3 = get_cpu()
c4 = get_cpu()
c5 = get_cpu()
sleep(2)
log("T04 A k=1 cpu=" + str(c1))
sleep(1)
log("T04 A k=2 cpu=" + str(c2))
sleep(1)
log("T04 A k=3 cpu=" + str(c3))
sleep(1)
log("T04 A k=4 cpu=" + str(c4))
sleep(1)
log("T04 A k=5 cpu=" + str(c5) + " t=" + str(get_unix_time() - t0))

# ============================================================
# PART A2 - same burst, but each read preceded by ONE filler line.
# This is the arm the previous draft lacked. A flat PART A is
# ambiguous between "the meter is latched and cannot resolve
# sub-second" and "get_cpu() is genuinely free". A2 separates them:
#   A flat + A2 climbing -> meter DOES resolve sub-second, so
#                           get_cpu() really is 0 ticks (doc right,
#                           this project's CORRECTION wrong).
#   A flat + A2 flat + B climbing -> meter is latched sub-second;
#                           PART A is dead as an instrument.
#   both climb -> A2 step minus A step = cost of one plain line,
#                 independently of PART B.
# ============================================================
sleep(4)
f = f + 1
a1 = get_cpu()
f = f + 1
a2 = get_cpu()
f = f + 1
a3 = get_cpu()
f = f + 1
a4 = get_cpu()
f = f + 1
a5 = get_cpu()
sleep(2)
log("T04 A2 k=1 cpu=" + str(a1))
sleep(1)
log("T04 A2 k=2 cpu=" + str(a2))
sleep(1)
log("T04 A2 k=3 cpu=" + str(a3))
sleep(1)
log("T04 A2 k=4 cpu=" + str(a4))
sleep(1)
log("T04 A2 k=5 cpu=" + str(a5) + " t=" + str(get_unix_time() - t0))

# ============================================================
# PART C - ambient floor probe. Reads spaced THREE seconds apart,
# not one. At 1s spacing a read can sit exactly on the sampling
# window's edge, and the previous draft's inference ("two steps
# means sleep() costs a tick") is then indistinguishable from a
# window slightly longer than one second. 3s spacing puts each
# read unambiguously outside the previous one's window under any
# window shorter than the observed ~3.7s clear time, so C measures
# the FLOOR and nothing else. C does NOT measure sleep()'s cost -
# that needs fractional sleeps and is not attempted here.
# ============================================================
sleep(4)
d1 = get_cpu()
sleep(3)
d2 = get_cpu()
sleep(3)
d3 = get_cpu()
sleep(2)
log("T04 C k=1 cpu=" + str(d1))
sleep(1)
log("T04 C k=2 cpu=" + str(d2))
sleep(1)
log("T04 C k=3 cpu=" + str(d3) + " t=" + str(get_unix_time() - t0))

# ============================================================
# PART B - the staircase. N filler lines, then ONE read.
# Filler is `f = f + 1`, NOT `x = 1`. A repeated identical store to
# a never-read variable is exactly what a constant-folder or a
# dead-store pass removes; if that happened, the old script's PART B
# would have gone FLAT and the old decision table routed a flat B to
# "CATASTROPHIC for the corpus". `f = f + 1` cannot be folded (each
# statement depends on the previous one) and cannot be dead-stored
# (f is printed at the end). The printed f is the audit: it MUST be
# 80. Any other value means lines were optimised away and every
# slope in this run is void.
#
# Staircase runs to N=26, not N=14. The corpus shows the lethal
# unpaced burst is ~150 executed lines (the "fatal 50" was 50 loop
# ITERATIONS, roughly 150 lines, never 50 lines), so 27 lines carries
# no real kill risk - and if the per-line step is nearer 2.7 points
# than 10 (see README: a ~3.7s window implies s = 100/37), N=14 never
# reaches the knee and the window length W is lost. N=20 and N=26 run
# LAST, after every other result is already printed.
# ============================================================

# --- N = 0 (settle check: should read the floor PART C measured) ---
sleep(4)
c = get_cpu()
sleep(2)
log("T04 B N=0 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 1 ---
sleep(4)
f = f + 1
c = get_cpu()
sleep(2)
log("T04 B N=1 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 3 ---
sleep(4)
f = f + 1
f = f + 1
f = f + 1
c = get_cpu()
sleep(2)
log("T04 B N=3 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 5 ---
sleep(4)
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
c = get_cpu()
sleep(2)
log("T04 B N=5 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 8 ---
sleep(4)
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
c = get_cpu()
sleep(2)
log("T04 B N=8 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 12 ---
sleep(4)
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
c = get_cpu()
sleep(2)
log("T04 B N=12 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 0 REPEAT (drift control + decay probe, captured before the
#     two largest bursts so it can never be lost to a kill) ---
sleep(4)
c = get_cpu()
sleep(2)
log("T04 B N=0r cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 20 ---
sleep(4)
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
c = get_cpu()
sleep(2)
log("T04 B N=20 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

# --- N = 26 (largest burst, 27 executed lines, ~2.7s at base tier,
#     LAST on purpose - a kill here is a datum, not a failure) ---
sleep(4)
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
f = f + 1
c = get_cpu()
sleep(2)
log("T04 B N=26 cpu=" + str(c) + " t=" + str(get_unix_time() - t0))

sleep(1)
log("T04 audit f=" + str(f) + " MUST BE 80 - any other value voids every slope")
sleep(1)
log("T04 done t=" + str(get_unix_time() - t0) + " - paste every T04 line, full precision, do not round")
