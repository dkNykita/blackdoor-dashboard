log("T17 SUM-READ (B-C)~0 => MODULE DECLS FREE, community claim holds and Krok 12 was right | (B-C)~" + str(nr / 2) + " => decls billed in modules too")
sleep(1)
log("T17 DONE 9/9 arms a=" + str(a) + " (must be 24) total=+" + str(get_unix_time() - t0) + "s cpu=" + str(get_cpu()) + " - paste EVERY T17 line")
