log("T17 SUM-RAW ctrl=" + str(nr) + " 12x2=" + str(n12) + " 4x6=" + str(n46) + " (all three arms are 24 raw lines)")
sleep(1)
log("T17 SUM-PRED per_raw_line=" + str(nr) + " per_stmt_12x2=" + str(nr / 2) + " per_stmt_4x6=" + str(nr / 6) + " free=0 - compare against SUM-RAW")
sleep(1)
log("T17 SUM-IMP A=" + str(ia1) + "/" + str(ia2) + " B=" + str(ib1) + "/" + str(ib2) + " C=" + str(ic1) + "/" + str(ic2) + " (n=1/n=2; n=2 ~0 while n=1 >0 => import IS cached per script)")
