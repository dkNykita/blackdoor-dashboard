log("T17 SUM-DEC rawlines24=(C-A)=" + str((ic1 + ic2) / 2 - (ia1 + ia2) / 2) + " decls12=(B-C)=" + str((ib1 + ib2) / 2 - (ic1 + ic2) / 2))
