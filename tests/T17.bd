    return 1
func i11():
    return 1
func i12():
    return 1
te = get_unix_time()
n12 = te - ts
sleep(2)
log("T17 INL arm=12x2 rawlines=24 decls=12 span=" + str(n12) + " cpu=" + str(get_cpu()) + " at=+" + str(get_unix_time() - t0))
sleep(2)

ts = get_unix_time()
func j01():
    z = 1
    z = 1
    z = 1
    z = 1
