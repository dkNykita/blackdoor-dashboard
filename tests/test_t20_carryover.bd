# tests/test_t20_carryover.bd - T20: CROSS-RUN CARRYOVER.
# Does the CPU meter reset between script runs?
#
# =====================================================================
# ONE QUESTION
# =====================================================================
#   On the VERY FIRST executable line of a new script, does get_cpu()
#   still show load left behind by whatever ran before it - and does a
#   script started seconds after an overload kill run DEGRADED even if
#   the meter reads clean?
#
# WHY THIS ONE IS OVERDUE
#   "No cross-run carryover" is written into field_notes.txt twice
#   (~line 644, ~line 822) and into the bug report itself as a PLAYER
#   ASSERTION. It has never been measured, despite being the cheapest
#   measurement in the whole corpus: one get_cpu() call on line 1.
#   The five crashes that define the central mystery (+40.7s, +111.0s,
#   +40.3s, +65.5s, +64.3s) were collected EXACTLY the way this test
#   manufactures carryover: five runs back to back, each started moments
#   after the previous one was killed. If a kill leaves residue, run N+1
#   starts with less headroom than run N, and the crash point walks for a
#   reason nobody has ever looked for.
#   The one existing anchor - test_cpu_decay.bd's first sample reading
#   exactly 0 - was taken after a long idle at the prompt, so it cannot
#   tell "reset at process start" apart from "fully decayed while you
#   were typing". This script separates them.
#
# =====================================================================
# THE FOUR MODELS THIS DISCRIMINATES
# =====================================================================
#   M1 PER-PROCESS RESET .... the meter is zeroed when a process starts.
#                             LINE1_cpu = 0 under EVERY prelude, gap
#                             irrelevant, and no throughput ramp.
#   M2 SESSION ACCUMULATOR .. one meter for the session, decaying in real
#                             time. LINE1_cpu falls monotonically as the
#                             launch gap grows: high (60-100) at <1s after
#                             a kill, floor (~0-10) after 30s.
#   M3 LIVE-PROCESS SUM ..... the docs say "aggregate CPU load across all
#                             your RUNNING processes". A dead process
#                             contributes nothing, so LINE1_cpu = 0 even
#                             one tick after the meter read 100.
#                             INDISTINGUISHABLE FROM M1 HERE - separating
#                             them needs the concurrent-process tests
#                             (T21+); this test only has to establish that
#                             the value is 0, and it tells them nothing.
#   M4 HIDDEN BUDGET DEBT ... the meter resets but the engine does not:
#                             the next script gets fewer real ticks/sec
#                             until it has recovered. LINE1_cpu = 0 AND
#                             R0 burst= is visibly longer than R3 burst=.
#                             This is the model a meter-only test would
#                             miss entirely, which is why every round is
#                             timed as well as sampled.
#
# =====================================================================
# WHAT EACH RESULT MEANS
# =====================================================================
#   LINE1_cpu high in B, falling with the gap, ~0 in D
#       -> M2. Launch timing is a live variance suspect, every
#          back-to-back run block in this investigation (including the
#          5-run block that defines the mystery) is confounded, and
#          T21-T25 must be re-spaced with forced idle between runs.
#   LINE1_cpu = 0 everywhere INCLUDING a sub-second post-kill launch
#       -> M1 or M3. The player's assertion is finally a measurement.
#          "The previous run poisoned this one" leaves the suspect list
#          permanently.
#   LINE1_cpu = 0 everywhere BUT R0 burst= > R3 burst= only after a kill
#       -> M4. Residue that the meter does not show and that no amount of
#          get_cpu() polling would ever have caught.
#   The probe DIES under prelude B but never under prelude D
#       -> the loudest possible confirmation of residue. The header line
#          has already printed by then, so a dead probe is still data.
#   LINE1_cpu is a fixed nonzero value under EVERY prelude including the
#   cold one (A)
#       -> not carryover at all but LAUNCH COST: this ~150-line file
#          charges the meter before line 1 runs. Compare against the
#          47-line file that read 0 (test_cpu_decay.bd) and against
#          T09's own launch reading. That is a finding too, and it is
#          why prelude A exists.
#
# =====================================================================
# OUTPUT FORMAT
# =====================================================================
#   Header (always first, always printed - THE HEADLINE):
#     T20[tag] mode=P LINE1_cpu=<c> t_abs=<t>
#       LINE1_cpu = get_cpu() on executable line 1. NOTHING in this
#                   process has run before it: not the param reads, not
#                   the timestamp, not a single log(). Whatever it says
#                   was put there by the environment, not by this script.
#       t_abs     = raw get_unix_time() at line 1. Absolute on purpose:
#                   subtract the bomb's own t_abs to get the real launch
#                   gap instead of trusting a stopwatch guess.
#   Per round (4 of them):
#     T20[tag] R<n> pre=<c> burst=<s> post=<c> at=<s>
#       R<n>  = round number, FIRST on the line, so a truncated final
#               line still says how far it got.
#       pre   = get_cpu() before the burst. NOT a clean drain curve - by
#               R0 this script has already executed ~10 lines and the
#               meter sawtooths ~10->90 per line (field_notes ~line 351).
#               It is an instrument-liveness check and a matched-control
#               series, nothing more.
#       burst = seconds for 20 unrolled `a = a + 1` lines. THE THROUGHPUT
#               READOUT - the only thing here that can see M4.
#       post  = get_cpu() straight after the burst. If this is not
#               markedly higher than pre=, the meter is not responding
#               and the run is void.
#       at    = seconds since line 1.
#   Final line (absent = the probe was killed, which is itself a result):
#     T20[tag] DONE rounds=4 a=100 ... LINE1_cpu=<c> total=<s> end_cpu=<c>
#               t_abs=<t>
#       LINE1_cpu is REPEATED here so a paste that loses its top still
#       carries the primary number. a=100 is the integrity check: any
#       other value means the bursts did not execute the statement count
#       the source shows and every burst= this run is void.
#
# =====================================================================
# HOW TO READ IT
# =====================================================================
#   1. Line up every LINE1_cpu against its launch gap (probe t_abs minus
#      bomb t_abs, minus the bomb's own time-to-die - measure that once
#      with `time run test_t20_carryover K`). Monotone decay = M2. Flat
#      zero = M1/M3. That scatter IS the cross-process decay curve.
#   2. Report the full float tail. 93.75 and 49.94140625 are dyadic;
#      10.0000001798557 is not. Which family this value belongs to says
#      whether it came from the same arithmetic as the in-run readings.
#   3. Compare R0 burst= against R3 burst= WITHIN each run, then compare
#      that gradient across preludes. Only a gradient that appears in B
#      and not in D means anything.
#   4. INTEGER CLOCK FALLBACK: if every burst= prints as a whole number,
#      get_unix_time() has 1-second resolution (the official reference
#      does declare it "-> int"). Then ignore burst= and read the at=
#      deltas between consecutive rounds, and total=, which aggregate 4
#      rounds and survive the quantization.
#
# =====================================================================
# HOW TO RUN - two modes, four preludes. @param binds POSITIONALLY.
# =====================================================================
#   mode 1st, tag 2nd:  run test_t20_carryover P B1
#
#   PRELUDE D (idle - the control, do this FIRST):
#     Sit at the prompt doing nothing for 30s, then
#       run test_t20_carryover P D1
#   PRELUDE B (post-kill - the important one):
#       run test_t20_carryover K &
#     then TYPE `run test_t20_carryover P B1` and DO NOT PRESS ENTER.
#     Press Enter the instant the [SYSTEM] CPU overloaded banner appears.
#     Vary the delay ON PURPOSE across repeats - that is the dose:
#       B1, B2 = as fast as you physically can (<1s)
#       B3     = count to five first
#       B4     = count to fifteen first
#     If `&` refuses the command, run the bomb in the foreground instead
#     and recall the probe with Up-Arrow + Enter after the banner.
#   PRELUDE C (post-normal-finish): every probe run deliberately ends
#     with an unpaced 20-line burst, so it exits HOT. The moment a probe
#     prints DONE, press Up-Arrow and Enter:
#       run test_t20_carryover P C1
#   PRELUDE A (cold): quit to the main menu, reload the save, and make
#       run test_t20_carryover P A1
#     the FIRST command of the session.
#
#   MINIMUM BLOCK (~3 min, already answers the core question):
#     D1, B1, B2, D2.
#   FULL BLOCK (~7 min): D1, B1, B2, B3, B4, C1, C2, D2, A1.
#     D at both ends is the drift control - if D1 and D2 disagree, the
#     session itself moved and the B values in between are suspect.
#   Run `ps` and `jobs` before D1 and paste that too.
#   Paste EVERY line of EVERY run, including the kill banners, and say
#   which tag went with which prelude and roughly how fast you pressed
#   Enter. A run that prints only its header line is a valid result -
#   paste it.
#
# =====================================================================
# SAFETY / IS THE BURST THE EXPERIMENT?
# =====================================================================
#   Mode K is a DELIBERATE overload. It is supposed to be killed, and the
#   kill terminates EVERY running script - do not run it while anything
#   you care about is running. It makes zero get_cpu() calls inside its
#   loop, so it cannot perturb the reading the probe is about to take.
#   Mode P paces itself: each round is ~25 executed lines (~2.5s of
#   continuous load at base tier) bracketed by sleep(2), comfortably
#   inside the documented 5s-at-100% window and far under the ~150-line
#   stretch that killed test_cpu_decay.bd. It should never die under
#   prelude D. If it dies under prelude B, that IS the finding.
#
# RUNTIME: probe ~23s, bomb ~6s. Minimum block ~3 min, full block ~7 min.
#
# @param mode "P = probe (the measurement), K = kill bomb (makes prelude B)" default="P"
# @param tag "prelude label printed on every line: A cold, B post-kill, C post-finish, D idle" default="?"

var c0 = get_cpu()
var t0 = get_unix_time()
var MODE = get_param("mode", "P")
var TAG = get_param("tag", "?")
log("T20[" + TAG + "] mode=" + MODE + " LINE1_cpu=" + str(c0) + " t_abs=" + str(t0))
var a = 0
var r = 0
var cb = 0
var ts = 0
var te = 0

if MODE == "K":
    log("T20[" + TAG + "] K ARMED - banner is your cue, press Enter on the probe NOW")
    while r < 3000 and get_unix_time() - t0 < 30:
        a = r * 2
        r = r + 1
    log("T20[" + TAG + "] K SURVIVED r=" + str(r) + " span=" + str(get_unix_time() - t0) + " cpu=" + str(get_cpu()) + " - REPORT THIS, it refutes the 5s kill rule")
else:
    while r < 4:
        cb = get_cpu()
        ts = get_unix_time()
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        a = a + 1
        te = get_unix_time()
        log("T20[" + TAG + "] R" + str(r) + " pre=" + str(cb) + " burst=" + str(te - ts) + " post=" + str(get_cpu()) + " at=" + str(te - t0))
        r = r + 1
        sleep(2)
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    a = a + 1
    log("T20[" + TAG + "] DONE rounds=" + str(r) + " a=" + str(a) + " (a must be 100) LINE1_cpu=" + str(c0) + " total=" + str(get_unix_time() - t0) + " end_cpu=" + str(get_cpu()) + " t_abs=" + str(get_unix_time()) + " - exits HOT: Up-Arrow+Enter now for a prelude-C sample")
