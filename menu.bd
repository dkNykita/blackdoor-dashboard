# menu - Target Dashboard & Launcher
# Shows a quick status snapshot for a target and lets you pick an
# action to run against it without retyping the target every time.
# There's no way for a script to launch another script (run() doesn't
# exist as a callable), so this calls utils/* action functions directly
# - nothing is duplicated, just called from here instead of a standalone
# wrapper script.
#
# Recon (registry/banner/os/security/users/specs/jobs/nmap/daemons) is
# folded straight into the dashboard instead of being a separate menu
# action - it's just a few more cheap calls on the same connection
# sweep, and there's no reason to make a whole extra step (or a whole
# extra script + connection) out of "read what's already there".
#
# FIREWALL/USERS(+cracked)/SPECS/JOBS/NMAP/SQLI all persist through
# utils/hostdata into ~/host_intel.txt, keyed by IP - hydrated once at
# startup and updated whenever a fresh read succeeds, so the dashboard
# still shows the last known answer instead of "not accessible" for
# anything this session's connection can't reach (not cracked yet,
# target offline, etc). See utils/hostdata for the file format.
#
# specs/jobs/nmap/the USERS name list are server properties that don't
# change on their own, so each is only ever fetched live ONCE per host
# (guarded by "still none" in utils/dashboard.bd's refresh_status()) -
# once host_intel.txt has an answer, later refreshes trust it instead
# of re-spending an authenticated call on data that isn't expected to
# move. USERS' cracked flags are the exception inside that: recomputed
# every refresh from `accounts` (a free local credentials-file read, no
# connection needed) so that part never goes stale even though the name
# list itself is fetched once. fw/noise/accounts/security/vuln/trace/
# planted-daemons stay live every refresh - either free (no auth) or
# genuinely change moment to moment.
#
# On a base-tier CPU (10 ticks/sec, the slowest load dropoff there is),
# firing several checks back to back on every dashboard redraw reliably
# overloads - they're fetched ONCE at startup (and again only via
# "r - refresh" or after a crack), with a real sleep between each;
# redrawing the dashboard between menu choices just reprints the cached
# values plus a fresh TRACE read (that one's a local traces() scan, not
# a probe - free to repeat).
#
# No mission target and none given -> defaults to your own IP
# (get_my_ip()) instead of raising, so this still works as a general
# "what does my own box look like" dashboard between missions.
#
# LOG FILE is NOT a live check - it's a per-session guess that flips to
# "not yet cleaned" the moment you crack/grab through this menu, and
# tracks separately whether the last cleanup was a real LogScrubber
# scrub (clears IDS's memory too) or just a raw delete/nothing (doesn't).
# See utils/dashboard.bd's print_dashboard() for the logs_dirty/
# ids_log_cleared display logic.
#
# Every "leave it blank" prompt below says "type -" instead of "default
# X" or "space + Enter" - confirmed (retested): prompt() does not submit
# on a bare Enter, and a lone space doesn't work either, the terminal's
# own input widget discards whitespace-only input before it ever reaches
# the script. The only reliable default/skip signal is a visible non-
# whitespace sentinel - "-" - which nu.prompt_default() checks for
# directly instead of the unreachable empty-after-trim() check this used
# to rely on. See utils/net.bd's prompt_default().
#
# @param target "target to manage (defaults to current mission target, or your own IP if neither is set)" default=""

# TEMP DEBUG (Krok 12 measurement pass): get_unix_time() costs 0 ticks
# (api_documentation.txt) - cheap to bookend every startup phase with,
# so the real wall-clock cost of each phase is finally MEASURED instead
# of guessed. Player-reported "Checking status..." delays have ranged
# from ~15 to 30+ minutes this session with no crash, no other process
# running (confirmed via `ps`/`jobs`) - these checkpoints narrow down
# WHICH phase actually eats that time before designing any further fix.
# Remove once the real bottleneck is identified.
var startup_t0 = get_unix_time()

# Importing 10 modules back to back with no gap is itself a sustained
# burst - utils/net's own header already documented this exact failure
# mode once before ("menu.bd hit real CPU overload from that alone,
# before running a single line of its own logic"). A real sleep(1)
# between each import gives the load meter genuine wall-clock time to
# decay between them instead of accumulating across all ten in one go.
import "/home/Nykita/scripts/utils/net" as nu
sleep(1)
import "/home/Nykita/scripts/utils/creds" as uc
sleep(1)
import "/home/Nykita/scripts/utils/probe" as up
sleep(1)
import "/home/Nykita/scripts/utils/crack" as ucr
sleep(1)
import "/home/Nykita/scripts/utils/grab" as ug
sleep(1)
import "/home/Nykita/scripts/utils/cleanup" as ucl
sleep(1)
import "/home/Nykita/scripts/utils/sqli" as usq
sleep(1)
import "/home/Nykita/scripts/utils/firewall" as ufw
sleep(1)
import "/home/Nykita/scripts/utils/hostdata" as uhd
sleep(1)
import "/home/Nykita/scripts/utils/sync" as usy
sleep(1)
# Krok 12: refresh_status()/print_dashboard()/mark_cracked()/
# print_separator() moved to utils/dashboard.bd - see that file's own
# header for the full reasoning (top-level SCRIPT func declarations
# cost ticks, module ones are cheaper to declare, though field_notes.txt
# notes importing itself scales with a module's total line count too -
# this move is this session's live test of whether the net effect is
# actually smaller, not a certainty).
import "/home/Nykita/scripts/utils/dashboard" as udb
# CONFIRMED this session (live test): a sleep(1) was missing here - the
# only import-boundary gap without one - right before ~18 var declarations
# and 4 func declarations (print_dashboard() alone ~135 lines) executing
# back to back with zero pacing. That unpaced stretch alone was enough to
# trip the sustained-100%-for-5s kill, with the very first nu.throttle()
# call afterward (inside get_entry()) arriving too late to help - this is
# why the overload kept relocating to whatever ran next each time an
# earlier loop got fixed, instead of going away. Adding this sleep(1) plus
# the one below (after the vars - there's no func block left in this file
# to add a second one for, now that Krok 12 moved them all out) fixed it -
# confirmed via a clean full startup + dashboard render with no crash.
sleep(1)
nu.debug_time("imports done", startup_t0)

# Krok 12: consolidated from ~20 separate top-level vars into one dict,
# since every field here now needs to be threaded into/out of
# utils/dashboard.bd's functions as a single `state` parameter (this
# codebase never trusts implicit mutation-by-reference across a function
# call - see net.bd's module-top-level-var caution). Bracket/dot WRITE
# on an existing dict is confirmed working (Krok 8a), which is what
# unblocks this - a computed key in an object LITERAL is the one thing
# that still doesn't parse, and this literal below uses only plain
# string keys, never a computed one.
#
# CONFIRMED (parse error, live, isolated test): object literals can't
# span multiple lines at all - "Expected property name in object
# literal", reproduced even with a bare 2-key literal and zero
# comments. Every other multi-line construct in this codebase (if/
# while/for bodies, function calls split across lines) is fine; object
# literals specifically must be written on ONE line. Field notes for
# individual keys below (can't live inline the way a comment normally
# would next to what it explains, for the same reason):
# - ids_log_cleared: separate from logs_dirty - true only right after a
#   successful do_scrub_log() (real LogScrubber, clears IDS's in-memory
#   record too), false after raw delete or crack/grab (neither touches
#   IDS's memory). Both are per-session guesses, not live checks - see
#   print_dashboard()'s own LOG FILE section in utils/dashboard.bd.
# - trace_ceiling: connect()'s own trace_time - this connection's trace
#   ceiling, fixed at connect time (not the live countdown
#   get_trace_time() reports while connected). none until the first
#   successful connect to this target. Shown on the dashboard so a
#   hopeless target (<= net.bd's trace_critical(), confirmed to loop
#   check_trace() forever if you try to work through it - see net.bd's
#   trace_hopeless()) is visible BEFORE picking an action, not
#   discovered via a failed one.
# - target_is_own_ip: set once per target (startup, "t") -
#   probe_firewall()/whois()/connect() all raise rather than degrade
#   gracefully on your own IP (confirmed: it's not a valid target the
#   same way a remote server is), and none of the connect()-based menu
#   actions (2/3/4/5/6) work there either. Skips those calls entirely
#   instead of attempting-and-catching, and greys out the actions that
#   can't do anything on this target.
var state = {"logs_dirty": false, "ids_log_cleared": false, "fw_active": false, "fw_layers": 0, "fw_layers_remaining": 0, "noise": 0, "accounts": [], "owner": "", "banner": "", "os_name": "", "security": -1, "trace_ceiling": none, "users": none, "next_vuln": none, "open_ports": none, "specs": none, "jobs": none, "daemons_here": none, "nmap_data": none, "sqli_status": none, "target_is_own_ip": false}
sleep(1)  # CONFIRMED fix - see comment above the imports
nu.debug_time("state declared", startup_t0)

# Local file maintenance (host_intel.txt entries, Network tab, wordlist) -
# see utils/sync for why this replaced a standalone sync_hosts script.
# NOT run automatically here anymore - do_sync()'s per-line throttled
# loops (known_hosts scan, credentials backfill, wordlist build) turned
# out to be the real cost behind a slow/overload-prone startup, confirmed
# this session. Available on demand via choice "s" in the dispatch loop
# below instead.

var target = ""
try:
    target = nu.resolve_raw_target(get_param("target"))
catch e:
    # No target given and no mission target set - nu.resolve_raw_target()
    # raises in that case. Fall back to your own IP instead of failing
    # outright, so this still works as a general dashboard between
    # missions (check your own specs/daemons/jobs, etc).
    target = get_my_ip()
    log("No target given and no mission target set - using your own IP " + target)

# Covers the fallback above AND an own IP typed/passed explicitly -
# either way, probe_firewall()/whois()/connect() don't work on it.
state.target_is_own_ip = (target == get_my_ip())
nu.debug_time("before get_entry()", startup_t0)

# Hydrate from disk once at startup only - actions later this session
# update the in-memory copy directly (see choices "1"/"3"/"4"/"7"), and
# refresh_status() never resets these fields on a failed/unauthenticated
# dip, so none of this gets clobbered by a stale re-read mid-session.
# One get_entry() call, not six separate get_*() ones - each is its own
# full file parse, and six of those back to back adds up once
# host_intel.txt has more than a couple hosts on file.
var cached = uhd.get_entry(nu, target)
state.open_ports = cached.ports
state.users = cached.users
state.specs = cached.specs
state.jobs = cached.jobs
state.nmap_data = cached.nmap
state.sqli_status = cached.sqli
nu.debug_time("get_entry() done", startup_t0)
state = udb.refresh_status(nu, uc, uhd, state, target)
nu.debug_time("refresh_status() done (total)", startup_t0)

# Purely informational (see net.bd's CPU tier auto-scaling comment for
# why nothing scales by this - tried and disproven live, tier-scaling
# wait durations turned out slower, not faster). Deliberately placed
# here rather than earlier: refresh_status() above has already gone
# through several of its own throttle() calls by this point, so this
# one extra line lands in an already-paced spot instead of stacking
# onto the unpaced startup stretch that crashed the script live when
# this lived up near the imports instead.
log("Local CPU: " + str(nu.local_tick_rate()) + " ticks/sec", Color.muted)

var first_render = true

while true:
    udb.print_dashboard(nu, state, target)
    if first_render:
        nu.debug_time("dashboard fully loaded (total startup)", startup_t0)
        first_render = false
    nu.throttle(nu.cpu_guard_conservative())
    log("")
    log("Select script to run:")
    # Ordered by typical usage sequence (recon -> open the box up ->
    # get in -> cover tracks -> the rest as needed), and colored by real
    # risk per the API docs' own Noise: numbers plus whether the action
    # opens a trace-carrying connect() at all. Green: no connect() at
    # all (probe/scan and sqli's web vectors never connect). Amber: a
    # real connect()+trace and/or cracking a password, even where it's
    # comparatively quiet (local_crack) - it's still the same family of
    # action as a remote crack, just from inside. Red: bypass_firewall
    # is 5.0 noise PER CALL, looped until every layer's down - the
    # noisiest thing here by far.
    log("  1 - probe (scan target's ports - common set, or full 1-65535 on request)", Color.green)
    # No native strikethrough exists in this API - log(msg, color) only
    # confirmed styling is color (see field_notes.txt). 2-6 all go
    # through connect(), which doesn't work on your own IP (confirmed) -
    # muted + relabeled instead of a fake strikethrough attempt.
    if state.target_is_own_ip:
        log("  2 - firewall bypass (needs a real target, not your own IP)", Color.muted)
    else:
        log("  2 - firewall bypass (chip away layers until filtered ports open - very noisy)", Color.red)
    nu.throttle(nu.cpu_guard_conservative())
    if state.target_is_own_ip:
        log("  3 - crack (needs a real target, not your own IP)", Color.muted)
        log("  4 - crack from inside (needs a real target, not your own IP)", Color.muted)
        log("  5 - cleanup (needs a real target, not your own IP)", Color.muted)
        log("  6 - grab (needs a real target, not your own IP)", Color.muted)
    else:
        log("  3 - crack (connect and brute-force an account's password, softening security first)", Color.amber)
        log("  4 - crack from inside (local_crack a 2nd account once you're already in - much quieter)", Color.amber)
        log("  5 - cleanup (LogScrubber - clears IDS's memory too, needs the tool - or delete the files outright)", Color.amber)
        log("  6 - grab (recursively download every file under a directory)", Color.amber)
    log("  7 - sqli (try a direct SQLi route, fall back to finding+submitting the login form)", Color.green)
    log("  t - change target (enter a new IP)")
    log("  s - resync (rebuild host list from known_hosts + credentials backfill - can take a while on a large file)")
    log("  r - refresh status")
    log("  0 - exit")
    sleep(nu.log_pace())
    nu.throttle(nu.cpu_guard_conservative())
    var choice = prompt("> ")
    choice = choice.trim()

    if choice == "0":
        log("bye.")
        exit()
    elif choice == "r":
        state = udb.refresh_status(nu, uc, uhd, state, target)
    elif choice == "s":
        usy.do_sync(nu, uc, uhd)
    elif choice == "t":
        var ip_input = nu.prompt_default("New target IP (type - to keep current): ", "")
        if ip_input == "":
            log("No IP given - staying on " + target + ".", Color.amber)
        else:
            target = ip_input
            state.target_is_own_ip = (target == get_my_ip())
            # Switching targets means none of the in-memory fields still
            # apply - re-hydrate from host_intel.txt for the new IP (same
            # as the one-time startup hydration) instead of carrying the
            # old target's cached ports/users/specs/jobs/nmap/sqli over.
            var new_cached = uhd.get_entry(nu, target)
            state.open_ports = new_cached.ports
            state.users = new_cached.users
            state.specs = new_cached.specs
            state.jobs = new_cached.jobs
            state.nmap_data = new_cached.nmap
            state.sqli_status = new_cached.sqli
            state = udb.refresh_status(nu, uc, uhd, state, target)
    elif choice == "1":
        sleep(nu.log_pace())
        nu.throttle(nu.cpu_guard_conservative())
        var full_answer = prompt("Full 1-65535 port scan instead of common ports? (y/N): ")
        full_answer = full_answer.trim()
        log("-> " + (full_answer == "" ? "(none)" : full_answer), Color.cyan)
        if full_answer == "y" or full_answer == "Y":
            state.open_ports = up.do_probe_full(nu, target)
        else:
            state.open_ports = up.do_probe(nu, target)
        uhd.set_ports(nu, target, state.open_ports)
    elif choice == "2":
        ufw.do_bypass_firewall(nu, target)
        sleep(nu.log_pace())
        nu.throttle(nu.cpu_guard_conservative())
        state = udb.refresh_status(nu, uc, uhd, state, target)
    elif choice == "3":
        var account = nu.prompt_default("Account to crack (type - for root): ", "root")
        var escalate_to = ""
        if account != "root":
            escalate_to = nu.prompt_default("Also crack this account from inside after (type - to skip): ", "")
        # do_crack() only ever returns after a real success (it retries
        # internally until it does, or aborts the whole script on active
        # IDS - or now, raises if the target's trace ceiling is hopeless,
        # see net.bd's trace_hopeless()). Caught here so a hopeless
        # target fails just this action instead of crashing the script.
        try:
            var crack_result = ucr.do_crack(nu, target, account, true, escalate_to)
            # Reaching this line means account (and escalate_to, if used)
            # are genuinely cracked. Persist that right now rather than
            # leaving it riding on refresh_status() below to get there.
            state = udb.mark_cracked(nu, uhd, state, target, account)
            if escalate_to != "":
                state = udb.mark_cracked(nu, uhd, state, target, escalate_to)
            state.nmap_data = crack_result.nmap
            uhd.set_nmap(nu, target, state.nmap_data)
            state.logs_dirty = true
            state.ids_log_cleared = false
        catch e:
            log(str(e), Color.amber)
        sleep(nu.log_pace())
        nu.throttle(nu.cpu_guard_conservative())
        state = udb.refresh_status(nu, uc, uhd, state, target)
    elif choice == "4":
        var default_as = len(state.accounts) > 0 ? state.accounts[0] : "root"
        var as_account = nu.prompt_default("Connect as which already-cracked account (type - for " + default_as + "): ", default_as)
        sleep(nu.log_pace())
        nu.throttle(nu.cpu_guard_conservative())
        var target_input = prompt("Account to crack from inside: ")
        var target_account = target_input.trim()
        log("-> " + (target_account == "" ? "(none)" : target_account), Color.cyan)
        # Same trace_hopeless() reasoning as choice "3" above.
        try:
            var escalate_result = ucr.do_escalate(nu, target, as_account, target_account)
            # Reaching this line means target_account is genuinely
            # cracked, persist it right away.
            state = udb.mark_cracked(nu, uhd, state, target, target_account)
            state.nmap_data = escalate_result.nmap
            uhd.set_nmap(nu, target, state.nmap_data)
        catch e:
            log(str(e), Color.amber)
        sleep(nu.log_pace())
        nu.throttle(nu.cpu_guard_conservative())
        state = udb.refresh_status(nu, uc, uhd, state, target)
    elif choice == "5":
        var account3 = nu.prompt_default("Account to clean up as (type - for root): ", "root")
        sleep(nu.log_pace())
        nu.throttle(nu.cpu_guard_conservative())
        var cleanup_mode = prompt("Use LogScrubber - clears IDS's memory too, needs the tool owned (type - for this), or delete the files outright? (scrub/delete): ")
        cleanup_mode = cleanup_mode.trim()
        log("-> " + (cleanup_mode == "" ? "(none)" : cleanup_mode), Color.cyan)
        # Same trace_hopeless() reasoning as choice "3" above.
        try:
            if cleanup_mode == "delete" or cleanup_mode == "d":
                ucl.do_raw_cleanup(nu, target, account3)
                state.logs_dirty = false
                state.ids_log_cleared = false
            else:
                ucl.do_scrub_log(nu, target, account3)
                state.logs_dirty = false
                state.ids_log_cleared = true
        catch e:
            log(str(e), Color.amber)
    elif choice == "6":
        var account2 = nu.prompt_default("Account to grab as (type - for root): ", "root")
        var path = nu.prompt_default("Directory to grab from (type - for /var/data): ", "/var/data")
        # Same trace_hopeless() reasoning as choice "3" above.
        try:
            ug.do_grab(nu, target, account2, path)
            state.logs_dirty = true
            state.ids_log_cleared = false
        catch e:
            log(str(e), Color.amber)
    elif choice == "7":
        var route_input = nu.prompt_default("Route to try directly (type - for /login): ", "/login")
        var page_input = nu.prompt_default("Login page to fall back to if that fails (type - to skip): ", "")
        var sqli_result = usq.do_sqli(nu, target, route_input, page_input)
        state.sqli_status = {"ran": true, "success": sqli_result.success}
        uhd.set_sqli(nu, target, state.sqli_status)
    else:
        log("Unknown option: " + choice)
