# dash.bd - PANEL REWRITE, PHASE 3 "first costed action: PROBE"
#
# P1 proved the panel model, P2 proved the read path. P3 proves the thing the
# whole rewrite is built on: COSTED WORK RUNS ONE CALL PER FRAME, the UI
# redraws between every step, and the job can be cancelled.
#
# The old suite could never cancel anything - it blocked inside a while loop
# until the work finished or the script died. Here a scan is a state machine
# the event loop advances one port at a time, so STOP is just a flag set
# inside render:.
#
# COST MODEL (the reason for job.nap):
#   Every executed line is 1 tick and the base tier runs 10 ticks/sec, so a
#   ~7-line step plus scan()'s 2 extra ticks is ~0.9s of solid execution.
#   Sleeping 0.8s after it holds the duty cycle near half instead of pinning
#   it. That is why scanning 40 ports takes ~a minute and why that is FINE -
#   the progress bar makes the wait legible, and the alternative (hammering)
#   is what killed the old suite.
#   We never call get_cpu(): per the CPU research its reading is a smoothed
#   sum across ALL scripts while the kill trigger reads each script's own
#   unsmoothed score, so pacing against it paces against the wrong number.
#   Pacing here is open-loop, from the published per-call tick costs.
#
# WHAT TO WATCH FOR:
#   1. PROBE fills the bar one port at a time, UI stays live throughout
#   2. STOP actually stops it mid-scan
#   3. On completion PORTS appears in the INTEL column AND survives a quit +
#      relaunch (that is the write path working)
#   4. CPU stays off 100 for the whole scan

var PORTS = [20, 21, 22, 23, 25, 53, 69, 80, 110, 111, 135, 139, 143, 161, 162, 389, 443, 445, 465, 514, 587, 636, 993, 995, 1433, 1521, 2049, 3306, 3389, 5432, 5900, 6379, 8000, 8080, 8443, 8888, 9200, 11211, 27017, 31337]

# How long the loop sleeps after each costed step, tunable live with f/s.
#
# MEASURED 2026-09-16, and it settles an argument: at 0.1s the scan holds a
# STABLE 60% (bar the usual startup spike). The tick-cost model predicted
# ~86% there, so real execution is materially cheaper than "1 line = 1 tick
# at 10 ticks/sec" implies - the same conservatism that showed up at idle
# (30-40% measured against 55% modelled). 0.1 is therefore the default, not
# the daring end of the range.
#
# Granular below the default because that is where the interesting cliff is:
# the kill needs 5s SUSTAINED at 100, so the useful question is how far past
# 0.1 this can go before the meter pins. Watch a real scan and back off if it
# does - and remember the displayed meter is a smoothed all-script sum, not
# the per-script number that actually kills, so treat SURVIVAL as the test.
var NAPS = [1.2, 0.8, 0.5, 0.3, 0.2, 0.15, 0.12, 0.1, 0.08, 0.06, 0.05, 0.04, 0.03, 0.02, 0.01]

func label(r, c, t):
    term_move(r, c)
    term_write(t)

func show(v):
    if v == "":
        return "-"
    return v

# Pull one "key=value" line out of the raw blob. Called from inside render:,
# where string work is free - which is why the blob is never pre-parsed.
func field(raw, key):
    var lines = raw.split("\n")
    for ln in lines:
        if ln.starts_with(key + "="):
            var parts = ln.split("=")
            if len(parts) > 1:
                return parts[1]
    return ""

# Rebuild the blob with one key replaced or appended. Also runs inside
# render: - only the save() call itself is costed, out in the loop body.
func put(raw, key, value):
    var out = ""
    var found = false
    var lines = raw.split("\n")
    for ln in lines:
        if ln != "":
            if ln.starts_with(key + "="):
                out = out + key + "=" + value + "\n"
                found = true
            else:
                out = out + ln + "\n"
    if not found:
        out = out + key + "=" + value + "\n"
    return out

func bar(w, i, total):
    var filled = 0
    if total > 0:
        filled = int(w * i / total)
    var s = ""
    var k = 0
    while k < w:
        if k < filled:
            s = s + "#"
        else:
            s = s + "-"
        k = k + 1
    return s

func push(ring, t):
    ring[0] = ring[1]
    ring[1] = ring[2]
    ring[2] = t
    return ring

func read_live():
    var n = get_noise()
    var t = get_trace_time()
    var tr = traces()
    return {"noise": n, "trace": t, "count": len(tr)}

# Drop a trailing/duplicate comma by rebuilding from the non-empty parts.
# Runs inside render:, so the split and rejoin are free - which is why
# step_probe() can afford to append a lazy trailing comma instead of paying
# ticks to avoid one.
func clean_list(s):
    var out = ""
    var parts = s.split(",")
    for p in parts:
        if p != "":
            if out != "":
                out = out + ","
            out = out + p
    return out

# ONE costed call per invocation, and as few LINES as possible: every line
# here is a tick paid once per port, so bookkeeping moved out of this
# function directly speeds up the scan. The end-of-list check and the comma
# cleanup both live in render: instead, where they cost nothing.
func step_probe(job, ip):
    var r = scan(ip, PORTS[job.i])
    if r.open:
        job.found = job.found + str(PORTS[job.i]) + ":" + r.service + ","
        job.n = job.n + 1
    job.i = job.i + 1
    return job

func paint_live(ui, d, live, ring, job):
    if ui.rows < 24 or ui.cols < 44:
        return
    var last = ui.rows - 1
    term_clear_rect(6, 14, 20, 4)
    term_color(Color.green)
    label(6, 14, str(int(live.noise)))
    label(7, 14, str(int(live.trace)) + "s")
    label(8, 14, str(live.count))
    label(9, 14, str(d.frames))
    term_clear_rect(18, 1, ui.cols - 2, 1)
    if job.kind != "":
        term_color(Color.amber)
        label(18, 2, "PROBE  [" + bar(24, job.i, len(PORTS)) + "]  " + str(job.i) + "/" + str(len(PORTS)) + "   open " + str(job.n))
    term_clear_rect(last - 3, 1, ui.cols - 2, 1)
    term_color(Color.muted)
    label(last - 3, 2, ring[0] + "   " + ring[1] + "   " + ring[2])

func paint_all(ui, d, live, ring, job):
    term_clear()
    if ui.rows < 24 or ui.cols < 44:
        term_color(Color.amber)
        label(0, 0, "enlarge this pane")
        return
    # numbers are always floats in BDScript - int() so term_move() never
    # gets a fractional column
    var rcol = int(ui.cols / 2) + 1
    var last = ui.rows - 1
    term_color(Color.cyan)
    term_box(0, 0, ui.cols, ui.rows)
    term_hline(2, 1, ui.cols - 2)
    term_color(Color.white)
    label(1, 2, "BLACKDOOR")
    term_color(Color.cyan)
    label(1, 14, show(d.ip) + "   " + show(d.hostname))
    term_color(Color.muted)
    label(4, 2, "OWNER")
    label(5, 2, "MY IP")
    label(6, 2, "NOISE")
    label(7, 2, "TRACE")
    label(8, 2, "TRACES")
    label(9, 2, "FRAMES")
    term_color(Color.white)
    label(4, 14, show(d.owner))
    label(5, 14, show(d.myip))
    term_color(Color.muted)
    label(4, rcol, "INTEL   (from " + show(d.ip) + ".txt)")
    label(6, rcol, "PORTS")
    label(7, rcol, "USERS")
    label(8, rcol, "FIREWALL")
    label(9, rcol, "SPECS")
    label(10, rcol, "JOBS")
    label(11, rcol, "NMAP")
    label(12, rcol, "SQLI")
    term_color(Color.white)
    label(6, rcol + 10, show(field(d.raw, "ports")))
    label(7, rcol + 10, show(field(d.raw, "users")))
    label(8, rcol + 10, show(field(d.raw, "fw")))
    label(9, rcol + 10, show(field(d.raw, "specs")))
    label(10, rcol + 10, show(field(d.raw, "jobs")))
    label(11, rcol + 10, show(field(d.raw, "nmap")))
    label(12, rcol + 10, show(field(d.raw, "sqli")))
    # SETTINGS sits below both columns (which run to row 12) rather than in
    # the left one, so its divider can span the full width without cutting
    # through the INTEL list.
    term_color(Color.cyan)
    term_hline(14, 1, ui.cols - 2)
    term_color(Color.muted)
    label(15, 2, "SETTINGS")
    term_color(Color.amber)
    label(16, 2, "[ - ]")
    term_click_zone(16, 2, 5, 1, "b_slower")
    label(16, 8, "[ + ]")
    term_click_zone(16, 8, 5, 1, "b_faster")
    term_color(Color.white)
    # "last scan" is measured, not modelled - the tick-cost estimate this
    # replaced was off by a wide margin. It sits next to the speed control on
    # purpose: change the knob, run a scan, read the consequence right here.
    label(16, 16, "SPEED  " + str(d.speed + 1) + "/" + str(len(NAPS)) + "    " + str(NAPS[d.speed]) + "s nap    last scan " + str(int(d.last)) + "s")
    term_color(Color.amber)
    label(last - 4, 2, "[ PROBE ]")
    term_click_zone(last - 4, 2, 9, 1, "b_probe")
    label(last - 4, 13, "[ STOP ]")
    term_click_zone(last - 4, 13, 8, 1, "b_stop")
    label(last - 4, 23, "[ REFRESH ]")
    term_click_zone(last - 4, 23, 11, 1, "b_refresh")
    label(last - 4, 36, "[ QUIT ]")
    term_click_zone(last - 4, 36, 8, 1, "b_quit")
    term_color(Color.muted)
    label(last - 1, 2, "p probe   x stop   f faster   s slower   r refresh   q quit   - click the panel first so keys reach it")
    paint_live(ui, d, live, ring, job)

var r = open_panel()
if not r.success:
    log("no script panel in this layout - add one to run this")
    log(r.error)
    return
term_cursor(false)

import "/home/test_box/scripts/dash/store" as st
sleep(1)

# STARTUP IS PACED ON PURPOSE. Measured 2026-09-16: the steady-state loop
# idles at 30-40%, but launch briefly spikes to 90-100% - ~20 statements
# running back-to-back is ~2s of solid ticks against a 5s-at-100% kill. It
# survives, but this is the exact window the old shell/ suite died in, and
# every later phase adds another import and more setup here. A sleep(1) every
# few statements costs a few seconds of launch time and keeps each burst
# short. Do not remove these to "speed up" startup.
var d = {"ip": "", "hostname": "", "owner": "", "myip": "", "raw": "", "frames": 0, "countdown": 40, "speed": 7, "t0": 0, "last": 0}
var tgt = get_target()
if tgt != none:
    d.ip = tgt.ip
    d.hostname = tgt.hostname
sleep(1)

d.myip = get_my_ip()
if d.ip != "":
    var w = whois(d.ip)
    d.owner = w.owner
sleep(1)

st.ensure_dir()
if d.ip != "":
    d.raw = st.load(d.ip)
sleep(1)

var live = read_live()
var ring = ["", "", "ready"]
var ui = {"cols": 0, "rows": 0, "dirty": true}
var job = {"kind": "", "phase": "", "i": 0, "n": 0, "found": ""}
var pend = ""
var nap = 0.25

while true:
    render:
        var sz = term_size()
        if sz.cols != ui.cols or sz.rows != ui.rows:
            ui.cols = sz.cols
            ui.rows = sz.rows
            ui.dirty = true
        pend = ""
        var e = get_event()
        var n = 0
        while n < 8:
            if e == none:
                break
            var act = ""
            if e.type == "click":
                act = e.zone_id
            elif e.type == "key":
                if e.key == "Q" or e.key == "q":
                    act = "b_quit"
                elif e.key == "R" or e.key == "r":
                    act = "b_refresh"
                elif e.key == "P" or e.key == "p":
                    act = "b_probe"
                elif e.key == "X" or e.key == "x":
                    act = "b_stop"
                elif e.key == "F" or e.key == "f":
                    act = "b_faster"
                elif e.key == "S" or e.key == "s":
                    act = "b_slower"
            if act == "b_quit":
                pend = "quit"
            elif act == "b_refresh":
                pend = "live"
            elif act == "b_probe":
                if job.kind == "" and d.ip != "":
                    job = {"kind": "probe", "phase": "scan", "i": 0, "n": 0, "found": ""}
                    ring = push(ring, "probe start")
                    ui.dirty = true
                    pend = "start"
            elif act == "b_stop":
                if job.kind != "":
                    job = {"kind": "", "phase": "", "i": 0, "n": 0, "found": ""}
                    ring = push(ring, "stopped")
                    ui.dirty = true
            elif act == "b_faster":
                if d.speed < len(NAPS) - 1:
                    d.speed = d.speed + 1
                    ui.dirty = true
            elif act == "b_slower":
                if d.speed > 0:
                    d.speed = d.speed - 1
                    ui.dirty = true
            e = get_event()
            n = n + 1
        d.frames = d.frames + 1
        d.countdown = d.countdown - 1
        if d.countdown <= 0:
            d.countdown = 40
            if pend == "":
                pend = "live"
        # End-of-list detection lives here rather than in step_probe(),
        # because comparisons inside render: are free and ticks inside the
        # step function are paid once per port.
        if job.kind != "" and job.i >= len(PORTS):
            d.raw = put(d.raw, "ports", clean_list(job.found))
            job = {"kind": "", "phase": "", "i": 0, "n": 0, "found": ""}
            ring = push(ring, "probe done")
            ui.dirty = true
            pend = "save"
        elif job.kind != "" and pend == "":
            pend = "step"
        if pend == "step":
            nap = NAPS[d.speed]
        else:
            nap = 0.25
        if ui.dirty:
            paint_all(ui, d, live, ring, job)
            ui.dirty = false
        else:
            paint_live(ui, d, live, ring, job)
    if pend != "":
        if pend == "quit":
            break
        elif pend == "step":
            job = step_probe(job, d.ip)
        elif pend == "start":
            d.t0 = get_unix_time()
        elif pend == "save":
            d.last = get_unix_time() - d.t0
            st.store(d.ip, d.raw)
            # paint_all() already ran this frame, before d.last existed, and
            # cleared the flag - so re-dirty to repaint with the real number.
            # Only paint_all() draws the SETTINGS row; without this the value
            # is computed correctly and simply never shown.
            ui.dirty = true
        elif pend == "live":
            live = read_live()
    sleep(nap)

term_clear()
term_cursor(true)
log("dash P3 stopped after " + str(d.frames) + " frames")
