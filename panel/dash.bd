# dash.bd - PANEL REWRITE, PHASE 4 "session + trace safety"
#
# P1 proved the panel model, P2 the read path, P3 that costed work can run a
# few calls per frame with the UI live and a working cancel. P4 opens a real
# connection, which is the first thing here that can go WRONG ON ITS OWN
# while you sit still: the trace runs down whether or not you act.
#
# THE RULE THAT SHAPES THIS PHASE: nothing the loop calls may exit() or
# raise(). The old suite's check_trace() called disconnect()/exit()/raise()
# inline - fine in a one-shot script, fatal in a long-running panel, where
# exit() kills the dashboard from inside a helper and raise() unwinds the
# event loop. dash/safe.bd therefore only REPORTS a verdict; the decision to
# drop the link is made in the dispatch, in the open.
#
# COST MODEL, as measured rather than assumed (full data in
# Internal/panel rewrite/results.txt):
#   The tick model predicts ELAPSED TIME well - a 40-port scan decomposes to
#   ~0.9s/port of irreducible work plus ~1.2s/frame of overhead, which is why
#   batching is worth ~50% and shortening the sleep below 0.1s is worth
#   almost nothing.
#   It does NOT predict the CPU meter: at sleep 0.1 the timings imply a 93%
#   duty cycle while the meter read 63%. So the meter is NOT a per-script
#   duty cycle and cannot be used to infer headroom. We never call get_cpu()
#   at all - pacing is open-loop from the published per-call tick costs.
#
# WHAT TO WATCH FOR:
#   1. CONNECT fills BANNER/OS (connect() returns them even when login
#      failed) and they persist to the blob for when you are offline again
#   2. The SESSION line counts the trace down and is coloured by verdict
#   3. It AUTO-DROPS the link at cool/abort/hopeless without being asked -
#      that is the whole point of the phase
#   4. The dashboard survives all of it, since nothing raises

# Shown in the title bar. Bump it on every edit - /mnt is not launchable
# directly, so what is running in-game is whatever was last copied into
# ~/scripts, and "is this even the new code?" is otherwise unanswerable.
var BUILD = "p4g"

var PORTS = [20, 21, 22, 23, 25, 53, 69, 80, 110, 111, 135, 139, 143, 161, 162, 389, 443, 445, 465, 514, 587, 636, 993, 995, 1433, 1521, 2049, 3306, 3389, 5432, 5900, 6379, 8000, 8080, 8443, 8888, 9200, 11211, 27017, 31337]

# How long the loop sleeps after each costed step, tunable live with f/s.
#
# MEASURED, by timing real scans rather than reading the meter: the sleep is
# exactly as linear as arithmetic says (0.1s x 40 ports = 4s, and the scans
# came in at 59s vs 55s) but it is a SMALL TERM. There is a ~0.9s/port floor
# of actual work underneath it that no sleep setting touches.
#
# So this knob is for DELIBERATE RESTRAINT, not for speed. Below ~0.1s it
# buys a few seconds out of a minute and costs peak headroom; the settings
# above 0.1 are the ones that do something, and 1.2s genuinely crawls. To
# make a scan faster, raise BATCH instead.
#
# An earlier version of this comment claimed the meter proved real execution
# was cheaper than the tick model - it did not. The meter is not a duty cycle
# (see the header). Judge pacing by elapsed time and by SURVIVAL, not by the
# percentage on screen.
var NAPS = [1.2, 0.8, 0.5, 0.3, 0.2, 0.15, 0.12, 0.1, 0.08, 0.06, 0.05, 0.04, 0.03, 0.02, 0.01]

# Ports scanned per frame. Trades progress granularity and STOP latency for
# amortised per-frame overhead: a STOP cannot land until the running batch
# finishes, so at ~0.9s/port that is ~3.7s at 4, ~7.4s at 8, ~15s at 16.
# Default 4 is the balance point - 45s against b1's 79s, while a cancel still
# lands in a few seconds. 8 is the speed knee (39s) if a run is worth waiting
# on; 16 gains one further second and is not worth double the wait.
var BATCHES = [1, 2, 4, 8, 16]

func label(r, c, t):
    term_move(r, c)
    term_write(t)

func show(v):
    if v == "":
        return "-"
    return v

func mark(on):
    if on:
        return "[x]"
    return "[ ]"

func onoff(on):
    if on:
        return "ENABLED"
    return "DISABLED"

# Pull one "key=value" line out of the raw blob. Called from inside render:,
# where string work is free - which is why the blob is never pre-parsed.
func field(raw, key):
    var lines = raw.split("\n")
    for ln in lines:
        if ln.starts_with(key + "="):
            var parts = ln.split("=")
            if len(parts) > 1:
                return parts[1]
    return ""

# Rebuild the blob with one key replaced or appended. Also runs inside
# render: - only the save() call itself is costed, out in the loop body.
func put(raw, key, value):
    var out = ""
    var found = false
    var lines = raw.split("\n")
    for ln in lines:
        if ln != "":
            if ln.starts_with(key + "="):
                out = out + key + "=" + value + "\n"
                found = true
            else:
                out = out + ln + "\n"
    if not found:
        out = out + key + "=" + value + "\n"
    return out

func bar(w, i, total):
    var filled = 0
    if total > 0:
        filled = int(w * i / total)
    var s = ""
    var k = 0
    while k < w:
        if k < filled:
            s = s + "#"
        else:
            s = s + "-"
        k = k + 1
    return s

func push(ring, t):
    ring[0] = ring[1]
    ring[1] = ring[2]
    ring[2] = t
    return ring

func read_live():
    var n = get_noise()
    var t = get_trace_time()
    var tr = traces()
    return {"noise": n, "trace": t, "count": len(tr), "list": tr}

# traces() keeps reporting a host after you disconnect, while its trace winds
# back down - so the session is still worth watching once the link is gone.
# Searching the list happens inside render:, where it is free.
# One definition of "this link has to go", used by both places that can
# reach that conclusion: the check dispatch acting on a reading it just took,
# and render: acting on a verdict set elsewhere (connect's ceiling gate).
# Same rule, two callers - not two rules.
func must_drop(v):
    if v == "":
        return false
    if v == "ok":
        return false
    if v == "flagged":
        return false
    return true

func find_trace(list, ip):
    for e in list:
        if e.ip == ip:
            return e
    return none

# Drop a trailing/duplicate comma by rebuilding from the non-empty parts.
# Runs inside render:, so the split and rejoin are free - which is why
# step_probe() can afford to append a lazy trailing comma instead of paying
# ticks to avoid one.
func clean_list(s):
    var out = ""
    var parts = s.split(",")
    for p in parts:
        if p != "":
            if out != "":
                out = out + ","
            out = out + p
    return out

# N costed calls per invocation, and as few LINES as possible: every line in
# the loop body is a tick paid once PER PORT, so bookkeeping here is what the
# scan time is made of. The comma cleanup lives in render: instead, free.
#
# Batching amortises per-frame overhead (loop header, dispatch ifs, sleep)
# across N ports. MEASURED on a 40-port scan at speed 8:
#     b1 79s (1.98s/port)   b4 45s (1.13s)   b8 39s (0.98s)   b16 38s (0.95s)
# Fitting per_port = A + B/n gives A ~= 0.9s of irreducible per-port work
# (~9 ticks: scan()'s 2 plus this loop body) and B ~= 1.2s of per-frame
# overhead. The curve knees at 8; 16 buys one more second for double the STOP
# latency. The bounds test is folded into the while condition to save a line
# per port.
#
# n=1 really is worse than the non-looping version it replaced - 79s against
# that version's 59s, i.e. the loop bookkeeping costs ~0.5s/port. Keep n=1 for
# comparison only; it is not a setting anyone should run.
func step_probe(job, ip, n):
    var k = 0
    while k < n and job.i < len(PORTS):
        var r = scan(ip, PORTS[job.i])
        if r.open:
            job.found = job.found + str(PORTS[job.i]) + ":" + r.service + ","
            job.n = job.n + 1
        job.i = job.i + 1
        k = k + 1
    return job

func paint_live(ui, d, live, ring, job, sess):
    if ui.rows < 24 or ui.cols < 44:
        return
    var last = ui.rows - 1
    var rcol = int(ui.cols / 2) + 1
    term_clear_rect(6, 14, rcol - 15, 5)
    term_color(Color.green)
    label(6, 14, str(int(live.noise)))
    label(7, 14, str(int(live.trace)) + "s")
    label(8, 14, str(live.count))
    label(9, 14, str(d.frames))
    # The verdict is carried by colour as well as text: this is the line that
    # says whether it is safe to still be on the box.
    if sess.on:
        if sess.verdict == "ok":
            term_color(Color.green)
        elif sess.verdict == "flagged":
            term_color(Color.amber)
        else:
            term_color(Color.red)
        # remaining/ceiling reads better than a bare countdown - 12s means
        # something different on a 20s box than on a 120s one
        if sess.ceiling > 0:
            label(10, 14, "UP   trace " + str(int(sess.trace)) + "s/" + str(int(sess.ceiling)) + "s   ids " + sess.ids + "   " + sess.verdict)
        else:
            label(10, 14, "UP   INSTANT TRACE   ids " + sess.ids + "   " + sess.verdict)
    else:
        # A dropped link does not mean the danger ended - traces() keeps
        # reporting the host while its trace winds back down, and that is
        # exactly the window in which reconnecting is a mistake. Track it.
        var te = find_trace(live.list, d.ip)
        var kc = field(d.raw, "ceiling")
        if te != none:
            term_color(Color.amber)
            label(10, 14, "offline   trace " + te.status + " " + str(int(te.remaining)) + "s/" + str(int(te.total)) + "s   let it clear")
        elif kc == "":
            term_color(Color.muted)
            label(10, 14, "offline")
        elif int(kc) <= 0:
            term_color(Color.red)
            label(10, 14, "offline   ceiling 0s - INSTANT TRACE, do not connect")
        else:
            term_color(Color.muted)
            label(10, 14, "offline   clear   ceiling " + kc + "s")
    term_clear_rect(18, 1, ui.cols - 2, 1)
    if job.kind != "":
        term_color(Color.amber)
        label(18, 2, "PROBE  [" + bar(24, job.i, len(PORTS)) + "]  " + str(job.i) + "/" + str(len(PORTS)) + "   open " + str(job.n))
    term_clear_rect(last - 3, 1, ui.cols - 2, 1)
    term_color(Color.muted)
    label(last - 3, 2, ring[0] + "   " + ring[1] + "   " + ring[2])

func paint_all(ui, d, live, ring, job, limits, sess):
    term_clear()
    if ui.rows < 24 or ui.cols < 44:
        term_color(Color.amber)
        label(0, 0, "enlarge this pane")
        return
    # numbers are always floats in BDScript - int() so term_move() never
    # gets a fractional column
    var rcol = int(ui.cols / 2) + 1
    var last = ui.rows - 1
    term_color(Color.cyan)
    term_box(0, 0, ui.cols, ui.rows)
    term_hline(2, 1, ui.cols - 2)
    term_color(Color.white)
    label(1, 2, "BLACKDOOR")
    term_color(Color.muted)
    label(1, 12, BUILD)
    term_color(Color.cyan)
    label(1, 18, show(d.ip) + "   " + show(d.hostname))
    term_color(Color.muted)
    label(4, 2, "OWNER")
    label(5, 2, "MY IP")
    label(6, 2, "NOISE")
    label(7, 2, "TRACE")
    label(8, 2, "TRACES")
    label(9, 2, "FRAMES")
    label(10, 2, "SESSION")
    label(11, 2, "BANNER")
    label(12, 2, "OS")
    term_color(Color.white)
    label(4, 14, show(d.owner))
    label(5, 14, show(d.myip))
    label(11, 14, show(field(d.raw, "banner")))
    label(12, 14, show(field(d.raw, "os")))
    term_color(Color.muted)
    label(4, rcol, "INTEL   (from " + show(d.ip) + ".txt)")
    label(6, rcol, "PORTS")
    label(7, rcol, "USERS")
    label(8, rcol, "FIREWALL")
    label(9, rcol, "SPECS")
    label(10, rcol, "JOBS")
    label(11, rcol, "NMAP")
    label(12, rcol, "SQLI")
    term_color(Color.white)
    label(6, rcol + 10, show(field(d.raw, "ports")))
    label(7, rcol + 10, show(field(d.raw, "users")))
    label(8, rcol + 10, show(field(d.raw, "fw")))
    label(9, rcol + 10, show(field(d.raw, "specs")))
    label(10, rcol + 10, show(field(d.raw, "jobs")))
    label(11, rcol + 10, show(field(d.raw, "nmap")))
    label(12, rcol + 10, show(field(d.raw, "sqli")))
    # SETTINGS sits below both columns (which run to row 12) rather than in
    # the left one, so its divider can span the full width without cutting
    # through the INTEL list.
    term_color(Color.cyan)
    term_hline(14, 1, ui.cols - 2)
    term_color(Color.muted)
    label(15, 2, "SETTINGS")
    term_color(Color.amber)
    label(16, 2, "[ - ]")
    term_click_zone(16, 2, 5, 1, "b_slower")
    label(16, 8, "[ + ]")
    term_click_zone(16, 8, 5, 1, "b_faster")
    term_color(Color.white)
    # "last scan" is measured, not modelled - the tick-cost estimate this
    # replaced was off by a wide margin. It sits next to the speed control on
    # purpose: change the knob, run a scan, read the consequence right here.
    label(16, 16, "SPEED  " + str(d.speed + 1) + "/" + str(len(NAPS)) + "    " + str(NAPS[d.speed]) + "s nap    last scan " + str(int(d.last)) + "s")
    # The master switch gates every action; the per-action switches decide
    # which ones it applies to. OFF still sleeps 0.01s - the loop must yield
    # or the panel cannot redraw, so "unlimited" means the floor of the
    # range, not no sleep at all.
    # Colour carries the state as well as the word, so it reads at a glance
    # without parsing the label - green is paced, red is running unchecked.
    if d.limit:
        term_color(Color.green)
    else:
        term_color(Color.red)
    label(17, 2, "LIMITER " + onoff(d.limit))
    term_click_zone(17, 2, 16, 1, "b_limit")
    term_color(Color.white)
    label(17, 22, "probe " + mark(limits["probe"]))
    term_click_zone(17, 22, 10, 1, "b_lim_probe")
    term_color(Color.amber)
    label(17, 36, "[ BATCH " + str(BATCHES[d.batch]) + " ]")
    term_click_zone(17, 36, 13, 1, "b_batch")
    term_color(Color.amber)
    label(last - 4, 2, "[ PROBE ]")
    term_click_zone(last - 4, 2, 9, 1, "b_probe")
    label(last - 4, 13, "[ STOP ]")
    term_click_zone(last - 4, 13, 8, 1, "b_stop")
    label(last - 4, 23, "[ CONNECT ]")
    term_click_zone(last - 4, 23, 11, 1, "b_connect")
    label(last - 4, 36, "[ RECON ]")
    term_click_zone(last - 4, 36, 9, 1, "b_recon")
    label(last - 4, 47, "[ DISCONN ]")
    term_click_zone(last - 4, 47, 11, 1, "b_disconnect")
    label(last - 4, 60, "[ REFRESH ]")
    term_click_zone(last - 4, 60, 11, 1, "b_refresh")
    label(last - 4, 73, "[ QUIT ]")
    term_click_zone(last - 4, 73, 8, 1, "b_quit")
    term_color(Color.muted)
    label(last - 1, 2, "p probe   x stop   c connect   g recon   d disconnect   f faster   s slower   l limiter   b batch   r refresh   q quit")
    paint_live(ui, d, live, ring, job, sess)

var r = open_panel()
if not r.success:
    log("no script panel in this layout - add one to run this")
    log(r.error)
    return
term_cursor(false)

import "/home/test_box/scripts/dash/store" as st
sleep(1)
import "/home/test_box/scripts/dash/safe" as sf
sleep(1)

# STARTUP IS PACED ON PURPOSE. Measured 2026-09-16: the steady-state loop
# idles at 30-40%, but launch briefly spikes to 90-100% - ~20 statements
# running back-to-back is ~2s of solid ticks against a 5s-at-100% kill. It
# survives, but this is the exact window the old shell/ suite died in, and
# every later phase adds another import and more setup here. A sleep(1) every
# few statements costs a few seconds of launch time and keeps each burst
# short. Do not remove these to "speed up" startup.
var d = {"ip": "", "hostname": "", "owner": "", "myip": "", "raw": "", "frames": 0, "countdown": 40, "speed": 7, "t0": 0, "last": 0, "limit": true, "batch": 2}
# One entry per action, keyed by job.kind. Every new action needs its key
# here or the pacing lookup will fail on it.
var limits = {"probe": true}
# A live connection. `poll` counts frames down to the next trace check - the
# trace is the one thing here that gets worse while you do nothing, so it is
# polled on a timer rather than only when acting. `stamped` records whether
# this session's banner/os have been written to the blob yet.
var sess = {"on": false, "conn": none, "user": "", "banner": "", "os": "", "trace": 0, "ceiling": 0, "ids": "", "verdict": "", "poll": 8, "stamped": false, "newconn": none, "newverdict": ""}
var tgt = get_target()
if tgt != none:
    d.ip = tgt.ip
    d.hostname = tgt.hostname
sleep(1)

d.myip = get_my_ip()
if d.ip != "":
    var w = whois(d.ip)
    d.owner = w.owner
sleep(1)

st.ensure_dir()
if d.ip != "":
    d.raw = st.load(d.ip)
sleep(1)

var live = read_live()
var ring = ["", "", "ready"]
var ui = {"cols": 0, "rows": 0, "dirty": true}
var job = {"kind": "", "phase": "", "i": 0, "n": 0, "found": ""}
var pend = ""
var nap = 0.25

while true:
    render:
        var sz = term_size()
        if sz.cols != ui.cols or sz.rows != ui.rows:
            ui.cols = sz.cols
            ui.rows = sz.rows
            ui.dirty = true
        pend = ""
        var e = get_event()
        var n = 0
        while n < 8:
            if e == none:
                break
            var act = ""
            if e.type == "click":
                act = e.zone_id
            elif e.type == "key":
                if e.key == "Q" or e.key == "q":
                    act = "b_quit"
                elif e.key == "R" or e.key == "r":
                    act = "b_refresh"
                elif e.key == "P" or e.key == "p":
                    act = "b_probe"
                elif e.key == "X" or e.key == "x":
                    act = "b_stop"
                elif e.key == "F" or e.key == "f":
                    act = "b_faster"
                elif e.key == "S" or e.key == "s":
                    act = "b_slower"
                elif e.key == "L" or e.key == "l":
                    act = "b_limit"
                elif e.key == "B" or e.key == "b":
                    act = "b_batch"
                elif e.key == "C" or e.key == "c":
                    act = "b_connect"
                elif e.key == "D" or e.key == "d":
                    act = "b_disconnect"
                elif e.key == "G" or e.key == "g":
                    act = "b_recon"
            if act == "b_quit":
                pend = "quit"
            elif act == "b_refresh":
                pend = "live"
            elif act == "b_probe":
                if job.kind == "" and d.ip != "":
                    job = {"kind": "probe", "phase": "scan", "i": 0, "n": 0, "found": ""}
                    ring = push(ring, "probe start")
                    ui.dirty = true
                    pend = "start"
            elif act == "b_stop":
                if job.kind != "":
                    job = {"kind": "", "phase": "", "i": 0, "n": 0, "found": ""}
                    ring = push(ring, "stopped")
                    ui.dirty = true
            elif act == "b_faster":
                if d.speed < len(NAPS) - 1:
                    d.speed = d.speed + 1
                    ui.dirty = true
            elif act == "b_slower":
                if d.speed > 0:
                    d.speed = d.speed - 1
                    ui.dirty = true
            elif act == "b_limit":
                d.limit = not d.limit
                ui.dirty = true
            elif act == "b_connect":
                if sess.on == false and d.ip != "":
                    pend = "connect"
            elif act == "b_recon":
                if sess.on == false and d.ip != "":
                    pend = "recon"
            elif act == "b_disconnect":
                if sess.on:
                    pend = "disconnect"
            elif act == "b_batch":
                d.batch = d.batch + 1
                if d.batch >= len(BATCHES):
                    d.batch = 0
                ui.dirty = true
            elif act == "b_lim_probe":
                limits["probe"] = not limits["probe"]
                ui.dirty = true
            e = get_event()
            n = n + 1
        d.frames = d.frames + 1
        # DROPPING A LINK OUTRANKS EVERYTHING ELSE COMPETING FOR THIS FRAME.
        # It runs first and overrides pend rather than waiting for a free
        # slot. The previous version sat at the BOTTOM of render: gated on
        # `pend == ""`, which worked until the adaptive poll started asking
        # for a "check" every single frame at low trace - after which the drop
        # could never get a turn, and the trace ran down to 1s with a correct
        # verdict sitting unread. Anything that must happen on time cannot
        # queue behind something that happens constantly.
        if sess.on and must_drop(sess.verdict):
            if pend != "quit":
                ring = push(ring, "auto-drop: " + sess.verdict)
                pend = "disconnect"
        d.countdown = d.countdown - 1
        if d.countdown <= 0:
            # Refresh often while a trace is winding down offline, rarely when
            # there is nothing moving. Without this the offline trace readout
            # would be up to 40 frames stale - useless for deciding when it is
            # safe to go back in.
            if live.count > 0:
                d.countdown = 8
            else:
                d.countdown = 40
            if pend == "":
                pend = "live"
        # The trace is the one thing that gets WORSE while you do nothing, so
        # it polls on its own timer rather than only when acting. ~8 frames is
        # a couple of seconds - fine against a trace measured in minutes, and
        # cheap enough at 0-tick reads.
        if sess.on:
            sess.poll = sess.poll - 1
            if sess.poll <= 0:
                # ADAPTIVE. A flat 8-frame poll is ~4.4s, which on a 20s
                # ceiling meant the drop was decided at ~7s left and landed at
                # ~5 - late, and on a shorter trace it would be later still.
                # Poll rarely when there is room, every frame when there is
                # not.
                if sess.trace > 30:
                    sess.poll = 8
                elif sess.trace > 12:
                    sess.poll = 3
                else:
                    sess.poll = 1
                if pend == "":
                    pend = "check"
        # connect() hands back banner/os even when login failed, so record
        # them once per session. Rebuilding the blob is free in here; only the
        # save() is costed. Deliberately NOT "save" - that branch also stamps
        # the scan duration and would clobber it.
        # Unpack a connection the dispatch parked last frame. All of this is
        # bookkeeping, so it belongs in here where it costs nothing.
        if sess.newconn != none:
            var nc = sess.newconn
            sess.newconn = none
            if sess.newverdict == "recon":
                # The link is already closed. This is pure offline
                # bookkeeping against the object it left behind.
                if nc.success:
                    d.raw = put(d.raw, "ceiling", str(int(nc.trace_time)))
                    d.raw = put(d.raw, "banner", nc.banner)
                    d.raw = put(d.raw, "os", nc.os)
                    ring = push(ring, "recon: ceiling " + str(int(nc.trace_time)) + "s")
                    if pend == "":
                        pend = "stamp"
                else:
                    ring = push(ring, "recon failed")
            elif nc.success:
                sess.on = true
                sess.conn = nc
                sess.user = nc.user
                sess.banner = nc.banner
                sess.os = nc.os
                sess.ceiling = nc.trace_time
                sess.trace = nc.trace_time
                sess.ids = "-"
                sess.poll = 8
                sess.stamped = false
                sess.verdict = sess.newverdict
                # success only means the port answered - an empty user means
                # the login did not happen, though the trace runs either way
                if nc.user == "":
                    ring = push(ring, "linked, not authed")
                else:
                    ring = push(ring, "linked as " + nc.user)
            else:
                ring = push(ring, "connect failed")
            ui.dirty = true
        if sess.on and sess.stamped == false:
            d.raw = put(d.raw, "ceiling", str(int(sess.ceiling)))
            d.raw = put(d.raw, "banner", sess.banner)
            d.raw = put(d.raw, "os", sess.os)
            sess.stamped = true
            ui.dirty = true
            if pend == "":
                pend = "stamp"
        # End-of-list detection lives here rather than in step_probe(),
        # because comparisons inside render: are free and ticks inside the
        # step function are paid once per port.
        if job.kind != "" and job.i >= len(PORTS):
            d.raw = put(d.raw, "ports", clean_list(job.found))
            job = {"kind": "", "phase": "", "i": 0, "n": 0, "found": ""}
            ring = push(ring, "probe done")
            ui.dirty = true
            pend = "save"
        elif job.kind != "" and pend == "":
            pend = "step"
        # Effective pacing = master switch AND this action's own switch.
        # Adding an action means adding its key to `limits`, or this lookup
        # will fail on it.
        if pend == "step":
            if d.limit and limits[job.kind]:
                nap = NAPS[d.speed]
            else:
                nap = 0.01
        else:
            nap = 0.25
        if ui.dirty:
            paint_all(ui, d, live, ring, job, limits, sess)
            ui.dirty = false
        else:
            paint_live(ui, d, live, ring, job, sess)
    if pend != "":
        if pend == "quit":
            break
        elif pend == "step":
            job = step_probe(job, d.ip, BATCHES[d.batch])
        elif pend == "start":
            d.t0 = get_unix_time()
        elif pend == "save":
            d.last = get_unix_time() - d.t0
            st.store(d.ip, d.raw)
            # paint_all() already ran this frame, before d.last existed, and
            # cleared the flag - so re-dirty to repaint with the real number.
            # Only paint_all() draws the SETTINGS row; without this the value
            # is computed correctly and simply never shown.
            ui.dirty = true
        elif pend == "live":
            live = read_live()
        elif pend == "stamp":
            st.store(d.ip, d.raw)
        elif pend == "connect":
            # THE API CALL AND NOTHING ELSE. Even plain assignments are ticks
            # out here, so the result is parked and unpacked inside render:
            # next frame, where it is free. Earlier versions did the blob
            # rebuild here (crashed), then eleven assignments here (~2s burst);
            # this is ~1s.
            var c = connect(d.ip, 22)
            var v = "fail"
            if c.success:
                v = sf.ceiling_verdict(c.trace_time)
            sess.newconn = c
            sess.newverdict = v
        elif pend == "recon":
            # CONNECT AND DROP ADJACENTLY - one line between them, so the
            # trace is exposed for a single line's execution rather than the
            # three frames a connect/stamp/disconnect cycle takes. That is
            # what makes it usable on a 0s-ceiling box.
            #
            # It works because NONE of what recon wants needs the link to stay
            # open: banner, os, trace_time and user are all fields of the
            # object connect() already returned. Reading them after the
            # disconnect is free and offline.
            #
            # Nothing else may be inserted between these two lines.
            var rc = connect(d.ip, 22)
            disconnect(rc)
            sess.newconn = rc
            sess.newverdict = "recon"
        elif pend == "disconnect":
            disconnect(sess.conn)
            sess.on = false
            sess.conn = none
            sess.verdict = ""
            ring = push(ring, "disconnected")
            ui.dirty = true
        elif pend == "check":
            # Acts on its own reading IMMEDIATELY rather than recording the
            # verdict and letting render: notice next frame. At low trace a
            # poll frame costs ~1.75s, so deferring cost a whole extra frame
            # of exposure on a threshold measured in seconds - the drop landed
            # at 6s against a COOL of 10.
            # This is two costed calls in one branch, which the dispatch
            # otherwise avoids, but check + disconnect is ~1.8s and the 5s
            # kill needs a sustained burst. Cheap insurance against a real
            # trace completing.
            var sv = sf.check(sess.conn, sess.ceiling)
            sess.trace = sv.trace
            sess.ids = sv.ids
            sess.verdict = sv.verdict
            if must_drop(sv.verdict):
                disconnect(sess.conn)
                sess.on = false
                sess.conn = none
                sess.verdict = ""
                ring = push(ring, "auto-drop: " + sv.verdict)
            ui.dirty = true
    sleep(nap)

term_clear()
term_cursor(true)
# quitting with a live session would leave the trace running on a connection
# nothing is watching any more
if sess.on:
    disconnect(sess.conn)
log("dash P4 stopped after " + str(d.frames) + " frames")
