#!/bin/sh
# Vault - pre-push pojistka: zadny force-push (prepis historie na GitHubu) pro zadneho agenta ani cloveka.
# Odmitne push, pri kterem vzdaleny commit neni predkem posilaneho (non-fast-forward).
# Mazani vzdalene vetve (napr. po sloucenem PR) povoli, krome main. Aktivace: python System/Scripts/vault_git.py setup
# Potom brana testu (.githooks/ci_gate.py prepush): selhani testu zastavi push na main, na ostatnich vetvich jen varuje.
input=$(cat)
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *)                         # mazani vetve
    if [ "$remote_ref" = "refs/heads/main" ]; then
      printf 'pre-push BLOK: smazani vzdaleneho main je zakazane\n' >&2
      fail=1
    fi
    continue ;; esac
  case "$remote_sha" in *[!0]*) ;; *) continue ;; esac       # nova vetev
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    printf 'pre-push BLOK: %s na serveru obsahuje commity, ktere tu nejsou (git fetch a merge)\n' "$remote_ref" >&2
    fail=1
  elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    printf 'pre-push BLOK: %s -> %s neni fast-forward (force-push je zakazany)\n' "$local_ref" "$remote_ref" >&2
    fail=1
  fi
done <<EOF
$input
EOF
gate=".githooks/ci_gate.py"
if [ "$fail" -eq 0 ] && [ -f "$gate" ]; then  # zamítnutý push (FF) se netestuje
  if python3 -c 'import sys' >/dev/null 2>&1; then py=python3; else py=python; fi
  printf '%s\n' "$input" | "$py" "$gate" prepush || fail=1
fi
exit $fail
